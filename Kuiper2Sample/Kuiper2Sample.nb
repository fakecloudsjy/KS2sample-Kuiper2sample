Cell[CellGroupData[{

Cell["Applications", "Subsection",
 TaggingRules->{},
 CellChangeTimes->{{3.9900192265008087`*^9, 3.990019227228943*^9}},
 CellTags->"DefaultContent",
 CellLabel->"In[1]:=",
 CellID->542143288,ExpressionUUID->"71893688-2156-5440-bd1a-03ca44078c74"],

Cell["\<\
EBSD (Electron Backscatter Diffraction) measures the orientation of each \
crystal grain in a polished rock sample. The first Euler angle \[CurlyPhi]\
\:2081 describes the rotation of the crystal about the sample normal axis and \
lives on the circle[0\[Degree], 360\[Degree]). Within a given mineral phase, \
grains belonging to the same texture component have identical \[CurlyPhi]\
\:2081, producing heavy natural ties by crystal symmetry. We compare the \
\[CurlyPhi]\:2081 distributions of Forsterite (olivine) and Enstatite \
(pyroxene) in a peridotite sample from the MTEX benchmark dataset (GPL-2.0):\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.9900191495570087`*^9, 3.990019155028551*^9}, {
   3.990019260644842*^9, 3.9900192627161274`*^9}, 3.9900195637679176`*^9, {
   3.9900206293043156`*^9, 3.9900206324127636`*^9}, {3.99002802944804*^9, 
   3.9900280872646275`*^9}, {3.9900281286867294`*^9, 3.990028165978119*^9}, 
   3.9900291761678925`*^9, 3.990030370238119*^9, {3.9900304245645046`*^9, 
   3.9900304513012695`*^9}, {3.9900306449110985`*^9, 
   3.9900306558610516`*^9}, {3.990031468883314*^9, 3.990031470986519*^9}},
 CellTags->"DefaultContent",
 CellID->143887807,ExpressionUUID->"06934e4c-8346-f540-8d10-ad1d61166eb7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "url", "=", \
"\"\<https://raw.githubusercontent.com/mtex-toolbox/mtex/develop/data/EBSD/\
Forsterite.ctf\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{"raw", "=", 
   RowBox[{"Import", "[", 
    RowBox[{"url", ",", "\"\<Lines\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dataLines", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"raw", ",", 
     RowBox[{
      RowBox[{"StringMatchQ", "[", 
       RowBox[{"#", ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"DigitCharacter", "~~", 
           RowBox[{"(", 
            RowBox[{"WhitespaceCharacter", "|", "EndOfString"}], ")"}]}], 
          ")"}], "~~", "___"}]}], "]"}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"table", "=", 
    RowBox[{"ImportString", "[", 
     RowBox[{
      RowBox[{"StringJoin", "[", 
       RowBox[{"Riffle", "[", 
        RowBox[{"dataLines", ",", "\"\<\\n\>\""}], "]"}], "]"}], 
      ",", "\"\<Table\>\""}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Phase", " ", "1"}], "=", "Forsterite"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"Phase", " ", "2"}], "=", "Enstatite"}], ";", 
     RowBox[{
      RowBox[{"column", " ", "6"}], "=", 
      RowBox[{"Euler1", " ", 
       RowBox[{"(", "phi1", ")"}], " ", "in", " ", "degrees"}]}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"forsteriteAngles", "=", 
   RowBox[{
    RowBox[{"Select", "[", 
     RowBox[{"table", ",", 
      RowBox[{
       RowBox[{
