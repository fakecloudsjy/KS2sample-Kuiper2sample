   3.9900189827977657`*^9, 3.990018986816904*^9}, {3.9900254298338146`*^9, 
   3.990025449536165*^9}, 3.990026180569586*^9},
 FontFamily->"Source Sans Pro",
 CellTags->{"DefaultContent", "TabNext"},
 CellID->61414320,ExpressionUUID->"8c35478a-5353-e348-a00d-ee1f1c647097"],

Cell[TextData[{
 "Returns the exact p-value ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "(", 
    RowBox[{
     SubscriptBox["V", 
      RowBox[{"m", "+", "n"}]], "\[GreaterEqual]", 
     StyleBox["q", "TI"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "f79e4667-2220-734a-ae9e-a934e766d194"],
 " given sample sizes ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], ",", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9b85b623-8cd3-cb43-884c-24a209295fa5"],
 " and observed statistic ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b172461f-5c46-6743-a209-ee30e846536b"],
 "."
}], "UsageDescription",
 TaggingRules->{},
 CellChangeTimes->{{3.9900189240450954`*^9, 3.990018955453808*^9}, {
  3.9900189931012573`*^9, 3.9900189946690807`*^9}, {3.990019428182722*^9, 
  3.990019433413578*^9}, {3.990020355805475*^9, 3.9900203573292503`*^9}, {
  3.9900254831211643`*^9, 3.9900254831211643`*^9}, {3.9900262056807537`*^9, 
  3.9900262099203377`*^9}},
 CellTags->{"DefaultContent", "TabNext"},
 CellID->33085349,ExpressionUUID->"4deebeed-a24b-124c-8da2-dcb1d435faad"]
}, Open  ]],

