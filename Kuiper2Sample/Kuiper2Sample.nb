Cell["\<\
Discrete circular data with ties: four mass points on the circle.The Kuiper \
test is well-suited to circular data because its statistic is invariant to \
the choice of origin on the circle:\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.9900191495570087`*^9, 3.990019155028551*^9}, 
   3.990019558388071*^9},
 CellTags->"DefaultContent",
 CellID->291939446,ExpressionUUID->"d41a1b89-8362-9247-85c8-ea65c23bbc96"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"data1", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"Pi", "/", "2"}], ",", "30"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"Pi", ",", "30"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"3", " ", 
        RowBox[{"Pi", "/", "2"}]}], ",", "30"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"2", " ", "Pi"}], ",", "30"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"data2", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"Pi", "/", "2"}], ",", "50"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"Pi", ",", "40"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"3", " ", 
        RowBox[{"Pi", "/", "2"}]}], ",", "10"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"2", " ", "Pi"}], ",", "50"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Kuiper2sample", "[", 
  RowBox[{"data1", ",", "data2"}], "]"}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{3.9900191594709167`*^9},
