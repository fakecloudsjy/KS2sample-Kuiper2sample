Cell["\<\
Compute the exact p-value of the two-sample Kuiper test for arbitrary data on \
the real line or circle with possible ties\
\>", "Text",
 Deletable->False,
 TaggingRules->{},
 CellEventActions->{Inherited, {"KeyDown", "\t"} :> Replace[SelectionMove[
       SelectedNotebook[], After, Cell]; NotebookFind[
