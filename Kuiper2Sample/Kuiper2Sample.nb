Cell[TextData[{
 "The Kuiper statistic is invariant to cyclic shifts of the data. Shifting ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["data", "TI"], 
   StyleBox["1", "TR"]]],ExpressionUUID->
  "66a82539-5ebf-524d-b813-83977617ac01"],
 " and ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox[
    StyleBox["data", "TI"], 
    StyleBox["2", "TR"]], "TI"]],ExpressionUUID->
  "78c9eab5-7745-a040-b1a4-ccab1b491e79"],
 " by an arbitrary constant on the circle leaves the Kuiper statistic and \
p-value unchanged:"
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.9900191495570087`*^9, 3.990019155028551*^9}, {
   3.990019260644842*^9, 3.9900192627161274`*^9}, 3.9900195637679176`*^9, {
   3.9900206293043156`*^9, 3.9900206324127636`*^9}, {3.99002802944804*^9, 
   3.9900280872646275`*^9}, {3.9900281286867294`*^9, 3.9900281314550667`*^9}},
 CellTags->"DefaultContent",
 CellID->103705588,ExpressionUUID->"6a8437ff-6483-3f47-a387-6533f7994d5e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"data1", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"Pi", "/", "2"}], ",", "30"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"Pi", ",", "30"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"3", " ", 
        RowBox[{"Pi", "/", "2"}]}], ",", "30"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"2", " ", "Pi"}], ",", "30"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"data2", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"Pi", "/", "2"}], ",", "50"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"Pi", ",", "40"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"3", " ", 
        RowBox[{"Pi", "/", "2"}]}], ",", "10"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"2", " ", "Pi"}], ",", "50"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"data1shifted", "=", 
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{"data1", "+", "Pi"}], ",", 
     RowBox[{"2", " ", "Pi"}]}], "]"}]}], ";", 
  RowBox[{"data2shifted", "=", 
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{"data2", "+", "Pi"}], ",", 
     RowBox[{"2", " ", "Pi"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Kuiper2sample", "[", 
    RowBox[{"data1shifted", ",", "data2shifted"}], "]"}], "[", 
   RowBox[{"[", "2", "]"}], "]"}], "==", 
  RowBox[{
   RowBox[{"Kuiper2sample", "[", 
    RowBox[{"data1", ",", "data2"}], "]"}], "[", 
   RowBox[{"[", "2", "]"}], "]"}]}]}], "Input",
 TaggingRules->{},
