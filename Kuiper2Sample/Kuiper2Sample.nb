Cell[CellGroupData[{

Cell["Neat Examples", "Subsection",
 TaggingRules->{},
 CellTags->"DefaultContent",
 CellID->303071976,ExpressionUUID->"894becee-1659-5a4b-a546-d733f3e57981"],

Cell["\<\
The Kuiper statistic is invariant under cyclic shifts. Shifting all \
observations by an arbitrary constant on the circle leaves the p-value \
exactly unchanged \[LongDash] a property no test on the real line can satisfy:\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.9900191495570087`*^9, 3.990019155028551*^9}, {
  3.990019260644842*^9, 3.9900192627161274`*^9}, {3.9900193675571213`*^9, 
  3.9900193793554974`*^9}, {3.9900195699526787`*^9, 3.990019766232321*^9}, {
  3.9900283018327904`*^9, 3.9900283057921314`*^9}},
 CellTags->"DefaultContent",
 CellID->463671809,ExpressionUUID->"97583668-1ba9-c14a-910b-ed1867d257db"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Four", " ", "equally", " ", "spaced", " ", "mass", " ", "points", " ", 
      RowBox[{"on", "[", 
       RowBox[{"0", ",", 
        RowBox[{"2", "\[Pi]"}]}]}]}], ")"}], " ", "with", " ", "unequal", " ",
     "weights"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"data1", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", "40"}], "]"}], ",", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "30"}], "]"}], ",", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"Pi", ",", "20"}], "]"}], ",", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"3", 
          RowBox[{"Pi", "/", "2"}]}], ",", "10"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"data2", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", "10"}], "]"}], ",", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "20"}], "]"}], ",", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"Pi", ",", "30"}], "]"}], ",", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"3", 
          RowBox[{"Pi", "/", "2"}]}], ",", "40"}], "]"}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v1", ",", "p1"}], "}"}], "=", 
     RowBox[{"Kuiper2sample", "[", 
      RowBox[{"data1", ",", "data2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Shift", " ", "every", " ", "observation", " ", "by", " ", 
     RowBox[{"Pi", "/", "3"}], " ", "on", " ", "the", " ", "circle", " ", 
     "and", " ", "retest"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"shift", "[", 
      RowBox[{"data_", ",", "s_"}], "]"}], ":=", 
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{"data", "+", "s"}], ",", 
       RowBox[{"2", " ", "Pi"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v2", ",", "p2"}], "}"}], "=", 
     RowBox[{"Kuiper2sample", "[", 
      RowBox[{
       RowBox[{"shift", "[", 
        RowBox[{"data1", ",", 
         RowBox[{"Pi", "/", "3"}]}], "]"}], ",", 
       RowBox[{"shift", "[", 
        RowBox[{"data2", ",", 
         RowBox[{"Pi", "/", "3"}]}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Statistic", " ", "and", " ", "p"}], "-", 
     RowBox[{"value", " ", "are", " ", "exactly", " ", "preserved"}]}], 
    "*)"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"v1", "==", "v2"}], ",", 
     RowBox[{"p1", "==", "p2"}]}], "}"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"->", 
     RowBox[{"{", 
      RowBox[{"True", ",", "True"}], "}"}]}], "*)"}]}]}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.990028259137499*^9, 3.990028259138481*^9}},
 CellLabel->"In[72]:=",
 CellID->10345107,ExpressionUUID->"4f9b2e93-40cf-9c45-a7d3-7cd8b01320af"],

