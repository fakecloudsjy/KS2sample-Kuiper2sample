Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"VerificationTest", "[", 
  RowBox[{"0", "<=", 
   RowBox[{
    RowBox[{"Kuiper2sample", "[", 
     RowBox[{
      RowBox[{"RandomVariate", "[", 
       RowBox[{
        RowBox[{"UniformDistribution", "[", "]"}], ",", "10"}], "]"}], ",", 
      RowBox[{"RandomVariate", "[", 
       RowBox[{
        RowBox[{"UniformDistribution", "[", "]"}], ",", "10"}], "]"}]}], 
     "]"}], "[", 
    RowBox[{"[", "2", "]"}], "]"}], "<=", "1"}], "]"}], "\n", 
 RowBox[{"VerificationTest", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Kuiper2sample", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}]}], "]"}], 
    "[", 
    RowBox[{"[", "2", "]"}], "]"}], ",", "1"}], "]"}], "\n", 
 RowBox[{"VerificationTest", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"d1", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{"Pi", "/", "2"}], ",", "10"}], "]"}], ",", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"Pi", ",", "10"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"d2", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{"Pi", "/", "2"}], ",", "15"}], "]"}], ",", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"Pi", ",", "5"}], "]"}]}], "]"}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Kuiper2sample", "[", 
        RowBox[{"d1", ",", "d2"}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}], "==", 
      RowBox[{
       RowBox[{"Kuiper2sample", "[", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"d1", "+", "Pi"}], ",", 
           RowBox[{"2", " ", "Pi"}]}], "]"}], ",", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"d2", "+", "Pi"}], ",", 
           RowBox[{"2", " ", "Pi"}]}], "]"}]}], "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], ",", "True"}], 
  "]"}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{
  3.990020650600582*^9, {3.9900207733185673`*^9, 3.990020775556654*^9}},
 CellTags->"DefaultContent",
 CellLabel->"In[12]:=",
 CellID->770806,ExpressionUUID->"9f7b39a3-18fa-8c4a-bb06-c967540c1de0"],

