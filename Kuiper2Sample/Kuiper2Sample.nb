Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"kuiperks", "[", 
    RowBox[{
    "m1_Integer", ",", "n1_Integer", ",", "qup_", ",", "qdown_", ",", 
     "multiplicity_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "p", ",", "r", ",", "ni", ",", "slope", ",", "deviatUp", ",", 
       "deviatDown", ",", "icat", ",", "nties", ",", "ile", ",", "iri", ",", 
       "iles", ",", "iris", ",", "iri2", ",", "ile2", ",", "dl", ",", 
       "newrct", ",", "l2", ",", "ileft", ",", "iright", ",", "jupp", ",", 
       "jlow"}], "}"}], ",", 
     RowBox[{
      RowBox[{"newrct", "=", "True"}], ";", 
      RowBox[{"ni", "=", 
       RowBox[{"m1", "+", "n1"}]}], ";", 
      RowBox[{"icat", "=", "2"}], ";", "\[IndentingNewLine]", 
      RowBox[{"p", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"m1", "+", "2"}]}], "]"}]}], ";", 
      RowBox[{
       RowBox[{"p", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "=", "1"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"slope", "=", 
       RowBox[{"m1", "/", "ni"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"deviatUp", "=", 
       RowBox[{"slope", "*", 
        RowBox[{"(", 
         RowBox[{"qup", "+", 
          RowBox[{"10", "^", 
           RowBox[{"-", "9"}]}]}], ")"}], "*", "n1"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"deviatDown", "=", 
       RowBox[{"slope", "*", 
        RowBox[{"(", 
         RowBox[{"qdown", "+", 
          RowBox[{"10", "^", 
           RowBox[{"-", "9"}]}]}], ")"}], "*", "n1"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ile", "=", 
       RowBox[{"iri", "=", 
        RowBox[{"ile2", "=", 
         RowBox[{"iri2", "=", 
          RowBox[{"l2", "=", 
           RowBox[{"dl", "=", "0"}]}]}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"nties", "=", 
       RowBox[{"multiplicity", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"r", "=", 
       RowBox[{"Prepend", "[", 
        RowBox[{"p", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"r", "=", 
          RowBox[{"Prepend", "[", 
           RowBox[{"p", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"nties", "==", "1"}], ",", 
           RowBox[{
            RowBox[{"dl", "=", 
             RowBox[{"L", "*", "slope"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"iri", "=", 
             RowBox[{"Min", "[", 
              RowBox[{
               RowBox[{"Floor", "[", 
                RowBox[{"dl", "+", "deviatDown"}], "]"}], ",", "L", ",", 
               "m1"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"ile", "=", 
             RowBox[{"Max", "[", 
              RowBox[{
               RowBox[{"Floor", "[", 
                RowBox[{"dl", "-", "deviatUp", "+", "1"}], "]"}], ",", 
               RowBox[{"L", "-", "n1"}], ",", "0"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"nties", "=", 
             RowBox[{"multiplicity", "[", 
              RowBox[{"[", "icat", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"icat", "=", 
             RowBox[{"icat", "+", "1"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"newrct", "=", "True"}]}], ",", 
           RowBox[{
            RowBox[{"nties", "=", 
             RowBox[{"nties", "-", "1"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{"newrct", ",", 
              RowBox[{
               RowBox[{"newrct", "=", "False"}], ";", "\[IndentingNewLine]", 
               RowBox[{"l2", "=", 
                RowBox[{"L", "+", "nties"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"dl", "=", 
                RowBox[{"l2", "*", "slope"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"iri2", "=", 
                RowBox[{"Min", "[", 
                 RowBox[{
                  RowBox[{"Floor", "[", 
                   RowBox[{"dl", "+", "deviatDown"}], "]"}], ",", "l2", ",", 
                  "m1"}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"ile2", "=", 
                RowBox[{"Max", "[", 
                 RowBox[{
                  RowBox[{"Floor", "[", 
                   RowBox[{"dl", "-", "deviatUp", "+", "1"}], "]"}], ",", 
                  RowBox[{"l2", "-", "n1"}], ",", "0"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"ileft", "=", "ile"}], ";", "\[IndentingNewLine]", 
               RowBox[{"iright", "=", "iri2"}], ";", "\[IndentingNewLine]", 
               RowBox[{"jupp", "=", 
                RowBox[{"l2", "-", "ile2"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"jlow", "=", 
                RowBox[{"L", "-", "iri", "-", "1"}]}]}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"ile", "=", 
             RowBox[{"Max", "[", 
              RowBox[{"ileft", ",", 
               RowBox[{"L", "-", "jupp"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"iri", "=", 
             RowBox[{"Min", "[", 
              RowBox[{"iright", ",", 
               RowBox[{"L", "-", "jlow"}]}], "]"}]}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"iles", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"0", ",", "ile"}], "]"}]}], ";", 
         RowBox[{"iris", "=", 
          RowBox[{"Min", "[", 
           RowBox[{"L", ",", "iri"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"p", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"iles", "+", "1"}], ")"}], ";;", 
             RowBox[{"(", 
              RowBox[{"iris", "+", "1"}], ")"}]}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"r", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"iles", "+", "2"}], ")"}], ";;", 
              RowBox[{"(", 
               RowBox[{"iris", "+", "2"}], ")"}]}], "]"}], "]"}], "+", 
           RowBox[{"r", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"iles", "+", "1"}], ")"}], ";;", 
              RowBox[{"(", 
               RowBox[{"iris", "+", "1"}], ")"}]}], "]"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"iles", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"1", ",", "ile"}], "]"}]}], ";", 
         RowBox[{"iris", "=", 
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{"L", "-", "1"}], ",", "iri"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"p", "[", 
           RowBox[{"[", "iles", "]"}], "]"}], "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"ile", "==", "0"}], ",", "1", ",", "0"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"p", "[", 
           RowBox[{"[", 
            RowBox[{"iris", "+", "2"}], "]"}], "]"}], "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"iri", "==", "L"}], ",", "1", ",", "0"}], "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"L", ",", "1", ",", 
          RowBox[{"ni", "-", "1"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"p", "[", 
        RowBox[{"[", 
         RowBox[{"m1", "+", "1"}], "]"}], "]"}], "+", 
       RowBox[{"p", "[", 
        RowBox[{"[", "m1", "]"}], "]"}]}]}]}], "]"}]}], "\[IndentingNewLine]",
   "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Kuiper2sample", "[", 
    RowBox[{"m_Integer", ",", "n_Integer", ",", "q_"}], "]"}], ":=", 
   RowBox[{"Kuiper2sample", "[", 
    RowBox[{"m", ",", "n", ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"1", ",", 
       RowBox[{"m", "+", "n"}]}], "]"}], ",", "q"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Kuiper2sample", "[", 
    RowBox[{
    "m_Integer", ",", "n_Integer", ",", "multiplicity_List", ",", "q_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nxy", ",", "ci", ",", "pos", ",", "neg", ",", "p"}], "}"}], ",", 
     RowBox[{
      RowBox[{"nxy", "=", 
       RowBox[{"LCM", "[", 
        RowBox[{"m", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ci", "=", 
       RowBox[{"Ceiling", "[", 
        RowBox[{
         RowBox[{"q", "*", "nxy"}], "-", "1"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{"ci", "<=", "0"}], ",", "1", ",", 
        RowBox[{"q", ">=", "2"}], ",", "0", ",", 
        RowBox[{"ci", "<=", 
         RowBox[{"nxy", "-", "1"}]}], ",", 
        RowBox[{
         RowBox[{"pos", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"m", ",", "n", ",", 
               RowBox[{"ci", "/", "nxy"}], ",", "0", ",", "multiplicity"}], 
              "}"}], "}"}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"m", ",", "n", ",", 
                RowBox[{"i", "/", "nxy"}], ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"ci", "-", "i"}], ")"}], "/", "nxy"}], ",", 
                "multiplicity"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "0", ",", 
                RowBox[{"ci", "-", "1"}]}], "}"}]}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"neg", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"m", ",", "n", ",", 
              RowBox[{"i", "/", "nxy"}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"ci", "-", "i", "-", "1"}], ")"}], "/", "nxy"}], ",", 
              "multiplicity"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", 
              RowBox[{"ci", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"MapApply", "[", 
               RowBox[{"kuiperks", ",", "pos"}], "]"}], "]"}], "-", 
             RowBox[{"Total", "[", 
              RowBox[{"MapApply", "[", 
               RowBox[{"kuiperks", ",", "neg"}], "]"}], "]"}]}], ")"}], "/", 
           RowBox[{"Binomial", "[", 
            RowBox[{
             RowBox[{"m", "+", "n"}], ",", "m"}], "]"}]}]}]}], ",", "True", ",", 
        RowBox[{
         RowBox[{"p", "=", 
          RowBox[{
           RowBox[{"2", "*", "nxy"}], "-", "ci"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"pos", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"m", ",", "n", ",", "1", ",", 
               RowBox[{
                RowBox[{"ci", "/", "nxy"}], "-", "1"}], ",", "multiplicity"}],
               "}"}], "}"}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"m", ",", "n", ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"ci", "-", "nxy", "+", "i"}], ")"}], "/", "nxy"}], ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"nxy", "-", "i"}], ")"}], "/", "nxy"}], ",", 
                "multiplicity"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "0", ",", 
                RowBox[{"p", "-", "1"}]}], "}"}]}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"neg", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"m", ",", "n", ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"ci", "-", "nxy", "+", "i"}], ")"}], "/", "nxy"}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"nxy", "-", "i", "-", "1"}], ")"}], "/", "nxy"}], ",",
               "multiplicity"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", 
              RowBox[{"p", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"MapApply", "[", 
               RowBox[{"kuiperks", ",", "pos"}], "]"}], "]"}], "-", 
             RowBox[{"Total", "[", 
              RowBox[{"MapApply", "[", 
               RowBox[{"kuiperks", ",", "neg"}], "]"}], "]"}]}], ")"}], "/", 
           RowBox[{"Binomial", "[", 
            RowBox[{
             RowBox[{"m", "+", "n"}], ",", "m"}], "]"}]}]}]}]}], "]"}]}]}], 
    "]"}]}], "\[IndentingNewLine]", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Kuiper2sample", "[", 
   RowBox[{"data1_List", ",", "data2_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m", ",", "n", ",", "joint", ",", "multiplicity", ",", "edf1", ",", 
      "edf2", ",", "z", ",", "dstat", ",", "pval"}], "}"}], ",", 
    RowBox[{
     RowBox[{"m", "=", 
      RowBox[{"Length", "[", "data1", "]"}]}], ";", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "data2", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"joint", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"Join", "[", 
        RowBox[{"data1", ",", "data2"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"multiplicity", "=", 
      RowBox[{"Values", "[", 
       RowBox[{"Counts", "[", "joint", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edf1", "=", 
      RowBox[{"EmpiricalDistribution", "[", "data1", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edf2", "=", 
      RowBox[{"EmpiricalDistribution", "[", "data2", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "CDF", " ", "differences", " ", "at", " ", "all", " ", "distinct", " ",
         "pooled"}], "-", 
       RowBox[{"sample", " ", "points"}]}], "*)"}], 
     RowBox[{"joint", "=", 
      RowBox[{"DeleteDuplicates", "[", "joint", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{
       RowBox[{"CDF", "[", 
        RowBox[{"edf1", ",", "joint"}], "]"}], "-", 
       RowBox[{"CDF", "[", 
        RowBox[{"edf2", ",", "joint"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dstat", "=", 
      RowBox[{
       RowBox[{"Max", "[", "z", "]"}], "+", 
       RowBox[{"Max", "[", 
        RowBox[{"-", "z"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pval", "=", 
      RowBox[{"Kuiper2sample", "[", 
       RowBox[{"m", ",", "n", ",", "multiplicity", ",", "dstat"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"dstat", ",", "pval"}], "}"}]}]}], "]"}]}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.9900262712872887`*^9, 3.9900262712883472`*^9}},
 CellLabel->"In[173]:=",
 CellID->267968477,ExpressionUUID->"d0c91412-b19c-5244-8274-da18209c25f5"]
}, Open  ]],

