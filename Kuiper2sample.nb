Cell["\<\
Discrete circular data with ties: four mass points on the circle.The Kuiper \
test is well-suited to circular data because its statistic is invariant to \
the choice of origin on the circle:\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.9900191495570087`*^9, 3.990019155028551*^9}, 
   3.990019558388071*^9},
 CellTags->"DefaultContent",
 CellID->291939446,ExpressionUUID->"b83d465a-3bb5-41e0-a7e4-1a7660f6b39c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"data1", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"Pi", "/", "2"}], ",", "30"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"Pi", ",", "30"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"3", " ", 
        RowBox[{"Pi", "/", "2"}]}], ",", "30"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"2", " ", "Pi"}], ",", "30"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"data2", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"Pi", "/", "2"}], ",", "50"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"Pi", ",", "40"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"3", " ", 
        RowBox[{"Pi", "/", "2"}]}], ",", "10"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"2", " ", "Pi"}], ",", "50"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Kuiper2sample", "[", 
  RowBox[{"data1", ",", "data2"}], "]"}]}], "Input",
 TaggingRules->{},
