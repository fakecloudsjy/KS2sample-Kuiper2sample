Cell[TextData[{
 "The Kuiper statistic is invariant to cyclic shifts of the data. Shifting ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["data", "TI"], 
   StyleBox["1", "TR"]]],ExpressionUUID->
  "573e1263-b4a6-fa4a-a9f5-727f3103cba0"],
 " by ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["Pi", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/Pi",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "29492104-b9e1-ea4c-b3e0-2be767a941db"],
 " on the circle leaves the p-value unchanged:"
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.9900191495570087`*^9, 3.990019155028551*^9}, {
   3.990019260644842*^9, 3.9900192627161274`*^9}, 3.9900195637679176`*^9, {
   3.9900206293043156`*^9, 3.9900206324127636`*^9}},
 CellTags->"DefaultContent",
 CellID->103705588,ExpressionUUID->"670d96a3-660c-f848-93a5-3dfaa85830f5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"data1", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"Pi", "/", "2"}], ",", "30"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"Pi", ",", "30"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"3", " ", 
        RowBox[{"Pi", "/", "2"}]}], ",", "30"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"2", " ", "Pi"}], ",", "30"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"data2", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"Pi", "/", "2"}], ",", "50"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"Pi", ",", "40"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"3", " ", 
        RowBox[{"Pi", "/", "2"}]}], ",", "10"}], "]"}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"2", " ", "Pi"}], ",", "50"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"data1shifted", "=", 
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{"data1", "+", "Pi"}], ",", 
     RowBox[{"2", " ", "Pi"}]}], "]"}]}], ";", 
  RowBox[{"data2shifted", "=", 
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{"data2", "+", "Pi"}], ",", 
     RowBox[{"2", " ", "Pi"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Kuiper2sample", "[", 
    RowBox[{"data1shifted", ",", "data2shifted"}], "]"}], "[", 
   RowBox[{"[", "2", "]"}], "]"}], "==", 
  RowBox[{
   RowBox[{"Kuiper2sample", "[", 
    RowBox[{"data1", ",", "data2"}], "]"}], "[", 
   RowBox[{"[", "2", "]"}], "]"}]}]}], "Input",
 TaggingRules->{},
