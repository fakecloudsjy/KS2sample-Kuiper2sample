  ExpressionUUID->"eaebde7d-a092-b84e-9d86-35706b1f707f"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "="}], TraditionalForm]],ExpressionUUID->
  "50cc3237-b868-874b-9459-186e0856fa89"],
 " ",
 Cell[BoxData[
  RowBox[{
   TagBox[
    ButtonBox["LCM",
     BaseStyle->Dynamic[
       FEPrivate`If[
        CurrentValue["MouseOver"], {
        "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
     ButtonData->"paclet:ref/GCD",
     ContentPadding->False],
    MouseAppearanceTag["LinkHand"]], "[", 
