Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"kuiperks", "[", 
    RowBox[{
    "m1_Integer", ",", "n1_Integer", ",", "qup_", ",", "qdown_", ",", 
     "M_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "P", ",", "R", ",", "Ni", ",", "SLOPE", ",", "DEVIATUP", ",", 
       "DEVIATDOWN", ",", "ICAT", ",", "NTIES", ",", "ILE", ",", "IRI", ",", 
       "ILES", ",", "IRIS", ",", "IRI2", ",", "ILE2", ",", "L", ",", "DL", ",",
        "NEWRCT", ",", "L2", ",", "ILEFT", ",", "IRIGHT", ",", "JUPP", ",", 
       "JLOW"}], "}"}], ",", 
     RowBox[{
      RowBox[{"NEWRCT", "=", "True"}], ";", 
      RowBox[{"Ni", "=", 
       RowBox[{"m1", "+", "n1"}]}], ";", 
      RowBox[{"ICAT", "=", "2"}], ";", "\[IndentingNewLine]", 
      RowBox[{"P", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"m1", "+", "2"}]}], "]"}]}], ";", 
      RowBox[{
       RowBox[{"P", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "=", "1"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SLOPE", "=", 
       RowBox[{"m1", "/", "Ni"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"DEVIATUP", "=", 
       RowBox[{"SLOPE", "*", 
        RowBox[{"(", 
         RowBox[{"qup", "+", 
          RowBox[{"10", "^", 
           RowBox[{"-", "9"}]}]}], ")"}], "*", "n1"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"DEVIATDOWN", "=", 
       RowBox[{"SLOPE", "*", 
        RowBox[{"(", 
         RowBox[{"qdown", "+", 
          RowBox[{"10", "^", 
           RowBox[{"-", "9"}]}]}], ")"}], "*", "n1"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ILE", "=", 
       RowBox[{"IRI", "=", 
        RowBox[{"ILE2", "=", 
         RowBox[{"IRI2", "=", 
          RowBox[{"L2", "=", 
           RowBox[{"DL", "=", "0"}]}]}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"NTIES", "=", 
       RowBox[{"M", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"R", "=", 
       RowBox[{"Prepend", "[", 
        RowBox[{"P", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"L", "=", "1"}], ",", 
        RowBox[{"L", "<=", 
         RowBox[{"Ni", "-", "1"}]}], ",", 
        RowBox[{"L", "++"}], ",", 
        RowBox[{
         RowBox[{"R", "=", 
          RowBox[{"Prepend", "[", 
           RowBox[{"P", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"NTIES", "==", "1"}], ",", 
           RowBox[{
            RowBox[{"DL", "=", 
             RowBox[{"L", "*", "SLOPE"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"IRI", "=", 
             RowBox[{"Min", "[", 
              RowBox[{
               RowBox[{"Floor", "[", 
                RowBox[{"DL", "+", "DEVIATDOWN"}], "]"}], ",", "L", ",", 
               "m1"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"ILE", "=", 
             RowBox[{"Max", "[", 
              RowBox[{
               RowBox[{"Floor", "[", 
                RowBox[{"DL", "-", "DEVIATUP", "+", "1"}], "]"}], ",", 
               RowBox[{"L", "-", "n1"}], ",", "0"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"NTIES", "=", 
             RowBox[{"M", "[", 
              RowBox[{"[", "ICAT", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"ICAT", "=", 
             RowBox[{"ICAT", "+", "1"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"NEWRCT", "=", "True"}]}], ",", 
           RowBox[{
            RowBox[{"NTIES", "=", 
             RowBox[{"NTIES", "-", "1"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{"NEWRCT", ",", 
              RowBox[{
               RowBox[{"NEWRCT", "=", "False"}], ";", "\[IndentingNewLine]", 
               RowBox[{"L2", "=", 
                RowBox[{"L", "+", "NTIES"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"DL", "=", 
                RowBox[{"L2", "*", "SLOPE"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"IRI2", "=", 
                RowBox[{"Min", "[", 
                 RowBox[{
                  RowBox[{"Floor", "[", 
                   RowBox[{"DL", "+", "DEVIATDOWN"}], "]"}], ",", "L2", ",", 
                  "m1"}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"ILE2", "=", 
                RowBox[{"Max", "[", 
                 RowBox[{
                  RowBox[{"Floor", "[", 
                   RowBox[{"DL", "-", "DEVIATUP", "+", "1"}], "]"}], ",", 
                  RowBox[{"L2", "-", "n1"}], ",", "0"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"ILEFT", "=", "ILE"}], ";", "\[IndentingNewLine]", 
               RowBox[{"IRIGHT", "=", "IRI2"}], ";", "\[IndentingNewLine]", 
               RowBox[{"JUPP", "=", 
                RowBox[{"L2", "-", "ILE2"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"JLOW", "=", 
                RowBox[{"L", "-", "IRI", "-", "1"}]}]}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"ILE", "=", 
             RowBox[{"Max", "[", 
              RowBox[{"ILEFT", ",", 
               RowBox[{"L", "-", "JUPP"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"IRI", "=", 
             RowBox[{"Min", "[", 
              RowBox[{"IRIGHT", ",", 
               RowBox[{"L", "-", "JLOW"}]}], "]"}]}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"ILES", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"0", ",", "ILE"}], "]"}]}], ";", 
         RowBox[{"IRIS", "=", 
          RowBox[{"Min", "[", 
           RowBox[{"L", ",", "IRI"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"P", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"ILES", "+", "1"}], ")"}], ";;", 
             RowBox[{"(", 
              RowBox[{"IRIS", "+", "1"}], ")"}]}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"R", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"ILES", "+", "2"}], ")"}], ";;", 
              RowBox[{"(", 
               RowBox[{"IRIS", "+", "2"}], ")"}]}], "]"}], "]"}], "+", 
           RowBox[{"R", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"ILES", "+", "1"}], ")"}], ";;", 
              RowBox[{"(", 
               RowBox[{"IRIS", "+", "1"}], ")"}]}], "]"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"ILES", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"1", ",", "ILE"}], "]"}]}], ";", 
         RowBox[{"IRIS", "=", 
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{"L", "-", "1"}], ",", "IRI"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"P", "[", 
           RowBox[{"[", "ILES", "]"}], "]"}], "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"ILE", "==", "0"}], ",", "1", ",", "0"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"P", "[", 
           RowBox[{"[", 
            RowBox[{"IRIS", "+", "2"}], "]"}], "]"}], "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"IRI", "==", "L"}], ",", "1", ",", "0"}], "]"}]}]}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"P", "[", 
        RowBox[{"[", 
         RowBox[{"m1", "+", "1"}], "]"}], "]"}], "+", 
       RowBox[{"P", "[", 
        RowBox[{"[", "m1", "]"}], "]"}]}]}]}], "]"}]}], "\n", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Kuiper2sample", "[", 
    RowBox[{"m_Integer", ",", "n_Integer", ",", "M_List", ",", "q_"}], "]"}], 
   ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nxy", ",", "Ci", ",", "pos", ",", "neg", ",", "p", ",", "i"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"nxy", "=", 
       RowBox[{"LCM", "[", 
        RowBox[{"m", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Ci", "=", 
       RowBox[{"Ceiling", "[", 
        RowBox[{
         RowBox[{"q", "*", "nxy"}], "-", "1"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{"Ci", "<=", "0"}], ",", "1", ",", 
        RowBox[{"q", ">=", "2"}], ",", "0", ",", 
        RowBox[{"Ci", "<=", 
         RowBox[{"nxy", "-", "1"}]}], ",", 
        RowBox[{
         RowBox[{"pos", "=", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"m", ",", "n", ",", 
             RowBox[{"Ci", "/", "nxy"}], ",", "0", ",", "M"}], "}"}], "}"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"neg", "=", 
          RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"pos", ",", 
              RowBox[{"{", 
               RowBox[{"m", ",", "n", ",", 
                RowBox[{"i", "/", "nxy"}], ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"Ci", "-", "i"}], ")"}], "/", "nxy"}], ",", "M"}], 
               "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"neg", ",", 
              RowBox[{"{", 
               RowBox[{"m", ",", "n", ",", 
                RowBox[{"i", "/", "nxy"}], ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"Ci", "-", "i", "-", "1"}], ")"}], "/", "nxy"}], ",",
                 "M"}], "}"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", 
             RowBox[{"Ci", "-", "1"}]}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"MapApply", "[", 
               RowBox[{"kuiperks", ",", "pos"}], "]"}], "]"}], "-", 
             RowBox[{"Total", "[", 
              RowBox[{"MapApply", "[", 
               RowBox[{"kuiperks", ",", "neg"}], "]"}], "]"}]}], ")"}], "/", 
           RowBox[{"Binomial", "[", 
            RowBox[{
             RowBox[{"m", "+", "n"}], ",", "m"}], "]"}]}]}]}], ",", "True", ",", 
        RowBox[{
         RowBox[{"p", "=", 
          RowBox[{
           RowBox[{"2", "*", "nxy"}], "-", "Ci"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"pos", "=", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"m", ",", "n", ",", "1", ",", 
             RowBox[{
              RowBox[{"Ci", "/", "nxy"}], "-", "1"}], ",", "M"}], "}"}], 
           "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"neg", "=", 
          RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"pos", ",", 
              RowBox[{"{", 
               RowBox[{"m", ",", "n", ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"Ci", "-", "nxy", "+", "i"}], ")"}], "/", "nxy"}], ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"nxy", "-", "i"}], ")"}], "/", "nxy"}], ",", "M"}], 
               "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"neg", ",", 
              RowBox[{"{", 
               RowBox[{"m", ",", "n", ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"Ci", "-", "nxy", "+", "i"}], ")"}], "/", "nxy"}], ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"nxy", "-", "i", "-", "1"}], ")"}], "/", "nxy"}], ",",
                 "M"}], "}"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", 
             RowBox[{"p", "-", "1"}]}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"MapApply", "[", 
               RowBox[{"kuiperks", ",", "pos"}], "]"}], "]"}], "-", 
             RowBox[{"Total", "[", 
              RowBox[{"MapApply", "[", 
               RowBox[{"kuiperks", ",", "neg"}], "]"}], "]"}]}], ")"}], "/", 
           RowBox[{"Binomial", "[", 
            RowBox[{
             RowBox[{"m", "+", "n"}], ",", "m"}], "]"}]}]}]}]}], "]"}]}]}], 
    "]"}]}], "\n", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Kuiper2sample", "[", 
   RowBox[{"data1_List", ",", "data2_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m", ",", "n", ",", "joint", ",", "M", ",", "edf1", ",", "edf2", ",", 
      "z", ",", "dstat", ",", "pval"}], "}"}], ",", 
    RowBox[{
     RowBox[{"m", "=", 
      RowBox[{"Length", "[", "data1", "]"}]}], ";", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "data2", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"joint", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"Join", "[", 
        RowBox[{"data1", ",", "data2"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"M", "=", 
      RowBox[{"Values", "[", 
       RowBox[{"Counts", "[", "joint", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edf1", "=", 
      RowBox[{"EmpiricalDistribution", "[", "data1", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edf2", "=", 
      RowBox[{"EmpiricalDistribution", "[", "data2", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "CDF", " ", "differences", " ", "at", " ", "all", " ", "distinct", " ",
         "pooled"}], "-", 
       RowBox[{"sample", " ", "points"}]}], "*)"}], 
     RowBox[{"joint", "=", 
      RowBox[{"DeleteDuplicates", "[", "joint", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{
       RowBox[{"CDF", "[", 
        RowBox[{"edf1", ",", "joint"}], "]"}], "-", 
       RowBox[{"CDF", "[", 
        RowBox[{"edf2", ",", "joint"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dstat", "=", 
      RowBox[{
       RowBox[{"Max", "[", "z", "]"}], "+", 
       RowBox[{"Max", "[", 
        RowBox[{"-", "z"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pval", "=", 
      RowBox[{"Kuiper2sample", "[", 
       RowBox[{"m", ",", "n", ",", "M", ",", "dstat"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"dstat", ",", "pval"}], "}"}]}]}], "]"}]}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{3.9900188879268494`*^9},
 CellTags->"DefaultContent",
 CellLabel->"In[1]:=",
 CellID->876320555,ExpressionUUID->"1c5823cc-e960-4cf1-ba41-843a736948b6"]
}, Open  ]],

