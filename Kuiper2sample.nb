 CellID->746063541,ExpressionUUID->"aef15fc9-974f-46b4-8432-97075a3bf1dc"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Kuiper2sample", "[", 
  RowBox[{
   StyleBox["m", "TI"], ",", 
   StyleBox["n", "TI"], ",", "M", ",", 
   StyleBox["q", "TI"]}], "]"}]], "UsageInputs",
 TaggingRules->{},
 CellChangeTimes->{{3.9900189173579464`*^9, 3.990018939219532*^9}, {
  3.9900189827977657`*^9, 3.990018986816904*^9}},
 FontFamily->"Source Sans Pro",
 CellTags->{"DefaultContent", "TabNext"},
 CellID->367030987,ExpressionUUID->"d8d7eb9f-4a42-f246-b091-b55dcc684e35"],

Cell[TextData[{
 "Returns the exact p-value ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "(", 
    RowBox[{
     SubscriptBox["V", 
      RowBox[{"m", "+", "n"}]], "\[GreaterEqual]", 
     StyleBox["q", "TI"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "293c0707-4835-a24c-887a-536438d7fc14"],
 " given sample sizes ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], ",", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "82eba69f-47d4-5d48-802e-d0c6db2e7999"],
 ", multiplicity vector ",
 Cell[BoxData["M"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0686805d-3bb2-e34c-9d7c-a6631e1ce7a0"],
 ", and observed statistic ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "04db977a-2221-8d41-b2f9-6c211fea4f49"],
 "."
}], "UsageDescription",
 TaggingRules->{},
 CellChangeTimes->{{3.9900189240450954`*^9, 3.990018955453808*^9}, {
  3.9900189931012573`*^9, 3.9900189946690807`*^9}, {3.990019428182722*^9, 
  3.990019433413578*^9}, {3.990020355805475*^9, 3.9900203573292503`*^9}},
 CellTags->{"DefaultContent", "TabNext"},
 CellID->765416180,ExpressionUUID->"ca4a9e33-db7b-1c43-9d75-d335f6e8720c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Details & Options",
 Cell[BoxData[
  PaneSelectorBox[{True->
   TemplateBox[{"Notes", 
     Cell[
      BoxData[
       FrameBox[
        Cell[
        "Give a detailed explanation of how the function is used and \
configured (e.g. acceptable input types, result formats, options \
specifications, background information). This section may include multiple \
cells, bullet lists, tables, hyperlinks and additional styles/structures as \
needed.\n\nAdd any other information that may be relevant, such as when the \
function was first discovered or how and why it is used within a given field. \
Include all relevant background or contextual information related to the \
function, its development, and its usage.", "MoreInfoText"], Background -> 
        GrayLevel[0.95], FrameMargins -> 20, FrameStyle -> GrayLevel[0.9], 
        RoundingRadius -> 5, ImageSize -> {
          Scaled[0.65], Automatic}]], "MoreInfoText", Deletable -> True, 
      CellTags -> {"SectionMoreInfoNotes"}, 
      CellMargins -> {{66, 66}, {15, 15}}]},
    "MoreInfoOpenerButtonTemplate"]}, Dynamic[
    CurrentValue[
     EvaluationNotebook[], {TaggingRules, "ResourceCreateNotebook"}]],
