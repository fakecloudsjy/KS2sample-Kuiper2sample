          "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
       ButtonData->"paclet:ref/LCM",
       ContentPadding->False],
      MouseAppearanceTag["LinkHand"]], "[", 
     RowBox[{
      StyleBox["m", "TI"], ",", 
      StyleBox["n", "TI"]}], "]"}], "=", 
    StyleBox["m", "TI"]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3f716802-7193-e24b-8a37-07449e84f401"],
 " so complexity is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox[
     StyleBox["m", "TI"], "3"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9866d626-ac49-434d-8d32-7efe61e31ae5"],
 ". When ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d0bfe2c9-ef93-d347-b8a9-886579623cde"],
 " and ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6bb1c1db-0453-ff4f-b830-fc48f7926e55"],
 " are coprime (e.g. ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", 
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d19bdeaf-d57c-0647-9214-1b1e1a889c7a"],
 "), ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TagBox[
     ButtonBox[
      StyleBox["LCM", "SymbolsRefLink",
       ShowStringCharacters->True,
       FontFamily->"Source Sans Pro"],
      BaseStyle->Dynamic[
        FEPrivate`If[
         CurrentValue["MouseOver"], {
         "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
      ButtonData->"paclet:ref/LCM",
      ContentPadding->False],
     MouseAppearanceTag["LinkHand"]], "[", 
    RowBox[{
     StyleBox["m", "TI"], ",", 
     StyleBox["n", "TI"]}], "]"}], "=", 
   StyleBox["mn", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ebf91b35-c070-624e-8f09-ba3ed60e482c"],
 " and complexity is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    RowBox[{
     SuperscriptBox[
      StyleBox["m", "TI"], "2"], 
     SuperscriptBox[
      StyleBox["n", "TI"], "2"]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "67d6b066-1f32-1e49-9b59-61cf986485bb"],
 ", which is much larger. For larger samples consider the R package KSgeneral \
which uses a compiled C++ implementation:"
}], "Text",
