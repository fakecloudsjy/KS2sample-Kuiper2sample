Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "d2", " ", "and", " ", "d3", " ", "are", " ", "drawn", " ", "from", " ", 
     "the", " ", "same", " ", "distribution", " ", "with", " ", "the", " ", 
     "same", " ", "seed"}], ",", 
    RowBox[{
    "so", " ", "they", " ", "have", " ", "nearly", " ", "identical", " ", 
     "Kuiper", " ", "statistics", " ", "against", " ", 
     RowBox[{"d1", ".", "The"}], " ", "timing", " ", "difference", " ", "is", 
     " ", "due", " ", "to", " ", 
     RowBox[{"LCM", "[", 
      RowBox[{"m", ",", "n"}], "]"}], " ", 
     RowBox[{"alone", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "5", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"d1", "=", 
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"UniformDistribution", "[", "]"}], ",", "100"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "99", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"d2", "=", 
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"UniformDistribution", "[", "]"}], ",", "100"}], "]"}]}], 
    ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"m", "=", 
      RowBox[{"n", "=", "100"}]}], ",", 
     RowBox[{"LCM", "=", "100"}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "99", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"d3", "=", 
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"UniformDistribution", "[", "]"}], ",", "101"}], "]"}]}], 
    ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"m", "=", "100"}], ",", 
     RowBox[{"n", "=", "101"}], ",", 
     RowBox[{"LCM", "=", "10100"}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Confirm", " ", "the", " ", "statistics", " ", "are", " ", "close"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Kuiper2sample", "[", 
       RowBox[{"d1", ",", "d2"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{"Kuiper2sample", "[", 
       RowBox[{"d1", ",", "d3"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Timing", " ", "comparison"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t2", ",", 
       RowBox[{"{", 
        RowBox[{"vstat2", ",", "pval2"}], "}"}]}], "}"}], "=", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{"Kuiper2sample", "[", 
       RowBox[{"d1", ",", "d2"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t3", ",", 
       RowBox[{"{", 
        RowBox[{"vstat3", ",", "pval3"}], "}"}]}], "}"}], "=", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{"Kuiper2sample", "[", 
       RowBox[{"d1", ",", "d3"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<m=n=100\>\"", ",", 
       RowBox[{"\"\<time\>\"", "->", "t2"}], ",", 
       RowBox[{"\"\<pval\>\"", "->", 
        RowBox[{"N", "[", 
         RowBox[{"pval2", ",", "10"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<m=100,n=101\>\"", ",", 
       RowBox[{"\"\<time\>\"", "->", "t3"}], ",", 
