}], "Subsection",
 Editable->False,
 Deletable->False,
 TaggingRules->{"TemplateGroupName" -> "Notes"},
 DefaultNewCellStyle->"Notes",
 CellTags->{"Details & Options", "Notes", "TemplateCellGroup"},
 CellLabel->"In[1]:=",
 CellID->447261062,ExpressionUUID->"ea376d75-eaef-4a43-b179-1f5a9e11331e"],

Cell[TextData[{
 "Kuiper2sample[",
 Cell[BoxData[
  RowBox[{
   StyleBox[
    SubscriptBox[
     StyleBox["data", "TI"], 
     StyleBox["1", "TR"]], "TI"], ",", 
   StyleBox[
    SubscriptBox[
     StyleBox["data", "TI"], 
     StyleBox["2", "TR"]], "TI"]}]],
  TaggingRules->{},
  CellChangeTimes->{{3.9900189173579464`*^9, 3.990018939219532*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "50305bcd-493b-324d-8b6a-204066feade5"],
 "] tests the null hypothesis ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "0"], TraditionalForm]],ExpressionUUID->
  "35fcfa2f-fcbe-ff49-bc32-f6b1ad768b89"],
 ": F(x) = G(x) for all x against H\:2081: F(x) \[NotEqual] G(x) where F and \
G are the unknown underlying CDFs of ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox[
    StyleBox["data", "TI"], 
    StyleBox["1", "TR"]], "TI"]],
  TaggingRules->{},
  CellChangeTimes->{
   3.990009560514303*^9, 3.9900096048586617`*^9, {3.9900152274730396`*^9, 
    3.9900152405971565`*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3aee5d05-c26d-584b-8d33-d10a901e2fd4"],
 " and ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox[
    StyleBox["data", "TI"], 
    StyleBox["2", "TR"]], "TI"]],
  TaggingRules->{},
  CellChangeTimes->{
   3.990009560514303*^9, 3.9900096048586617`*^9, {3.9900152274730396`*^9, 
    3.9900152405971565`*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "87ae95d1-a2ba-4f49-a5cd-4dfa668ae7a4"],
 " respectively; both samples may come from continuous, discrete, or mixed \
distributions and may contain ties."
}], "Notes",
 TaggingRules->{},
 CellEventActions->{Inherited, {"KeyDown", "\t"} :> Replace[SelectionMove[
       SelectedNotebook[], After, Cell]; NotebookFind[
       SelectedNotebook[], "TabNext", Next, CellTags, AutoScroll -> True, 
       WrapAround -> True], Blank[NotebookSelection] :> SelectionMove[
       SelectedNotebook[], All, CellContents, AutoScroll -> True]], 
   PassEventsDown -> False, PassEventsUp -> False},
 CellChangeTimes->{
  3.990019009701092*^9, 3.990019445363695*^9, {3.9900198846423664`*^9, 
   3.990019913337496*^9}, {3.9900199663236885`*^9, 3.990019970556114*^9}, {
   3.990020002507784*^9, 3.9900200302423534`*^9}, {3.990020062217373*^9, 
   3.9900201207005577`*^9}},
 CellTags->{"DefaultContent", "TabNext"},
 CellID->422531486,ExpressionUUID->"ba7a1f9e-085b-4848-9508-d364f79c4c25"],

Cell[TextData[{
 "The Kuiper statistic is defined as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[FinalSigma]", 
     RowBox[{"m", ",", "n"}]], "=", 
    RowBox[{
     RowBox[{
      UnderscriptBox["sup", 
       RowBox[{"t", "\[Element]", " ", "\[DoubleStruckCapitalR]"}]], "[", 
      RowBox[{
       RowBox[{
        SubscriptBox["F", "m"], "(", "t", ")"}], "-", 
       RowBox[{
        SubscriptBox["G", "n"], "(", "t", ")"}]}], "]"}], "\[Minus]", 
     RowBox[{
      UnderscriptBox["inf", 
       RowBox[{"t", "\[Element]", " ", "\[DoubleStruckCapitalR]"}]], "[", 
      RowBox[{
       RowBox[{
        SubscriptBox["F", "m"], "(", "t", ")"}], "-", 
       RowBox[{
        SubscriptBox["G", "n"], "(", "t", ")"}]}], "]"}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "552276c3-962f-5341-8a4d-3580da107c4c"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", "m"], "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "745313c0-5a24-9f4f-b746-1eb09fe6300d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["G", "n"], "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "2c6d2070-43d4-3e45-b6af-6950e10be1b1"],
 " are the empirical CDF of the ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox[
    StyleBox["data", "TI"], 
    StyleBox["1", "TR"]], "TI"]],
  TaggingRules->{},
  CellChangeTimes->{
   3.990009560514303*^9, 3.9900096048586617`*^9, {3.9900152274730396`*^9, 
    3.9900152405971565`*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b454fc33-75df-f145-9fba-dad311a10534"],
 " and ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox[
    StyleBox["data", "TI"], 
    StyleBox["2", "TR"]], "TI"]],
  TaggingRules->{},
  CellChangeTimes->{
   3.990009560514303*^9, 3.9900096048586617`*^9, {3.9900152274730396`*^9, 
    3.9900152405971565`*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e695423b-c315-2344-9f45-6ae283a87c0b"],
 ". It is invariant to cyclic shifts, making it ideal for circular and \
seasonal data and uniformly sensitive across the full support of the \
distribution."
}], "Notes",
 TaggingRules->{},
 CellEventActions->{Inherited, {"KeyDown", "\t"} :> Replace[SelectionMove[
       SelectedNotebook[], After, Cell]; NotebookFind[
       SelectedNotebook[], "TabNext", Next, CellTags, AutoScroll -> True, 
       WrapAround -> True], Blank[NotebookSelection] :> SelectionMove[
       SelectedNotebook[], All, CellContents, AutoScroll -> True]], 
   PassEventsDown -> False, PassEventsUp -> False},
 CellChangeTimes->{{3.990019009701092*^9, 3.9900190209013176`*^9}, {
  3.9900201303161545`*^9, 3.9900201707407207`*^9}},
 CellTags->{"DefaultContent", "TabNext"},
 CellID->49355424,ExpressionUUID->"51369d58-da7d-0a44-8656-9af31060443d"],

Cell[TextData[{
 "The p-value is the exact conditional probability ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "(", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", 
       RowBox[{"m", "+", "n"}]], "\[GreaterEqual]", 
      StyleBox["q", "TI"]}], 
     StyleBox["|", "TI"], 
     SubscriptBox[
      StyleBox["Z",
       FontWeight->"Bold"], 
      RowBox[{"m", "+", "n"}]]}], ")"}], TraditionalForm]],ExpressionUUID->
  "8fbaed8f-7f90-ea42-9e03-aba3d0f8f681"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", 
    RowBox[{"m", "+", "n"}]], TraditionalForm]],ExpressionUUID->
  "ba6bb192-137d-b340-9030-6d3962408f05"],
 " is permutation version of the Kuiper statistic ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[FinalSigma]", 
    RowBox[{"m", ",", "n"}]], TraditionalForm]],ExpressionUUID->
  "29b11aa2-1c18-774f-b3ec-10222083070a"],
 " obtained by randomly repartitioning the pooled sample ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["Z",
      FontWeight->"Bold"], 
     RowBox[{"m", "+", "n"}]], "=", 
    RowBox[{"{", 
     RowBox[{
      StyleBox[
       SubscriptBox[
        StyleBox["data", "TI"], 
        StyleBox["1", "TR"]], "TI"], ",", 
      StyleBox[
       SubscriptBox[
        StyleBox["data", "TI"], 
        StyleBox["2", "TR"]], "TI"]}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"804ef5e6-a6b8-754c-8c53-64ebba1ac451"],
 " into two groups of sizes ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5a8e9797-ba73-fa47-9763-7b2de826bc8a"],
 " and ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "19b133c3-49f9-3d45-9af8-088a4e972eca"],
 "."
}], "Notes",
 TaggingRules->{},
 CellEventActions->{Inherited, {"KeyDown", "\t"} :> Replace[SelectionMove[
       SelectedNotebook[], After, Cell]; NotebookFind[
       SelectedNotebook[], "TabNext", Next, CellTags, AutoScroll -> True, 
       WrapAround -> True], Blank[NotebookSelection] :> SelectionMove[
       SelectedNotebook[], All, CellContents, AutoScroll -> True]], 
   PassEventsDown -> False, PassEventsUp -> False},
 CellChangeTimes->{{3.990019009701092*^9, 3.9900190209013176`*^9}, {
   3.9900201303161545`*^9, 3.9900201707407207`*^9}, 3.9900203098846283`*^9, {
   3.990020382217966*^9, 3.990020384444765*^9}},
 CellTags->{"DefaultContent", "TabNext"},
 CellID->309935745,ExpressionUUID->"b7d621de-67fe-cb49-88ae-29c07cf81aca"],

Cell[TextData[{
 "The data-interface form Kuiper2sample[",
 Cell[BoxData[
  RowBox[{
   StyleBox[
    SubscriptBox[
     StyleBox["data", "TI"], 
     StyleBox["1", "TR"]], "TI"], ",", 
   StyleBox[
    SubscriptBox[
     StyleBox["data", "TI"], 
     StyleBox["2", "TR"]], "TI"]}]],
  TaggingRules->{},
  CellChangeTimes->{{3.9900189173579464`*^9, 3.990018939219532*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "485c7338-2068-3e49-89af-f8782f17b6f4"],
 "] returns the list {",
 Cell[BoxData[
  RowBox[{
   StyleBox["v", "TI"], ",", 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ed818ddb-dbb6-eb4b-a241-0c144b70b4f3"],
 "} where v is the observed Kuiper statistic and p is the exact rational \
p-value. The low-level form Kuiper2sample[",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], ",", 
   StyleBox["n", "TI"], ",", "M", ",", 
   StyleBox["q", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cf7d38c8-1ca8-6047-b8e2-fa0329e87ec7"],
 "] returns only the p-value."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{
  3.990019031061001*^9, {3.990019456083851*^9, 3.9900194626361885`*^9}},
 CellID->124384718,ExpressionUUID->"b2694972-fc91-994b-a849-66a12425ad84"],

Cell[TextData[{
 " In the low-level form, ",
 Cell[BoxData["M"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "68f7ee06-a96f-234b-929d-7533b4b7ebc1"],
 " is an integer list of length k (number of distinct pooled-sample values) \
with ",
 Cell[BoxData[
  RowBox[{"M", "[", 
   RowBox[{"[", 
    StyleBox["i", "TI"], "]"}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "98dbf278-eb3f-c647-b5df-61d9808566fd"],
 " the count of the ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "641993c0-767a-eb45-b6b2-69f4f97bc226"],
 "-th distinct value; ",
 Cell[BoxData[
  RowBox[{
   TagBox[
    ButtonBox[
     StyleBox["Total", "SymbolsRefLink",
      ShowStringCharacters->True,
      FontFamily->"Source Sans Pro"],
     BaseStyle->Dynamic[
       FEPrivate`If[
        CurrentValue["MouseOver"], {
        "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
     ButtonData->"paclet:ref/Total",
     ContentPadding->False],
    MouseAppearanceTag["LinkHand"]], "[", "M", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7131900d-59d4-1646-a315-337087d0eda6"],
 " must equal ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "+", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "211ae89b-9d67-9848-84f5-23c420a1f3e3"],
 ". ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "263c7a90-7f72-8f45-b07a-679e81fb9b78"],
 " must lie in [0, 2]."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.990019035708292*^9, 3.9900190395801697`*^9}, {
  3.9900194711535816`*^9, 3.99001948802516*^9}},
 CellID->64091601,ExpressionUUID->"1d5e9c40-f770-d947-8329-72c4345464c2"],

Cell[TextData[{
 "The p-value ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "(", 
    RowBox[{
     SubscriptBox["V", 
      RowBox[{"m", "+", "n"}]], "\[GreaterEqual]", 
     StyleBox["q", "TI"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "743a6924-cef2-994e-b22a-2077e0b75956"],
 " is computed via the permutation formulation of Proposition 2 of Dimitrova, \
Jia, Kaishev (2026), which expresses N\[Prime] as an alternating sum of \
one-sided trajectory counts N(a, b), each computed by the KS recurrence with \
asymmetric bounds. The simplified formula of Remark 2.3 of Dimitrova, Jia, \
Kaishev (2026) is used when ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "47216dd3-8312-f040-b30d-b9557328b2a4"],
 " > 1."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{
  3.9900190470685043`*^9, {3.990020198855982*^9, 3.9900202146221066`*^9}, {
   3.990020259780657*^9, 3.9900202648923016`*^9}, {3.9900203046521053`*^9, 
   3.9900203506019707`*^9}, 3.990020405067301*^9},
 CellID->483646850,ExpressionUUID->"945166dd-db11-cb43-ac07-565c1de02e29"],

Cell[TextData[{
 "The worst-case complexity is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    RowBox[{
     StyleBox["mn", "TI"], "*", "r"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "05e856b7-749f-b344-82d1-25f0e8292d4d"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "="}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "da50e237-dd33-e54b-8e92-c672b4356a2e"],
 " ",
 Cell[BoxData[
  RowBox[{
   TagBox[
    ButtonBox[
     StyleBox["GCD", "SymbolsRefLink",
      ShowStringCharacters->True,
      FontFamily->"Source Sans Pro"],
     BaseStyle->Dynamic[
       FEPrivate`If[
        CurrentValue["MouseOver"], {
        "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
     ButtonData->"paclet:ref/GCD",
     ContentPadding->False],
    MouseAppearanceTag["LinkHand"]], "[", 
   RowBox[{
    StyleBox["m", "TI"], ",", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7d7e20ff-a0c3-e749-acc8-da6705222615"],
 "; when ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "895b092d-2e1a-a24b-b6fa-8ad412461489"],
 " is large (e.g. ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4fe9d51d-3bfe-af45-b5ea-64436c029dba"],
 "), it reduces to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "m\.b2n", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e25abb48-06a4-b04f-8afc-b73879ce42a3"],
 "."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{
  3.9900190550927143`*^9, {3.9900195099288826`*^9, 3.9900195336827507`*^9}, {
   3.990019792550598*^9, 3.990019841500824*^9}},
 CellID->470673315,ExpressionUUID->"fa3634a1-1c18-1541-89ce-55c5797fccab"],

Cell[TextData[{
 "This is the Mathematica counterpart of ",
 StyleBox["Kuiper2sample",
  FontVariations->{"Underline"->True}],
 " and ",
 StyleBox["Kuiper2sample_Rcpp",
  FontVariations->{"Underline"->True}],
 " in the R package ",
 ButtonBox["KSgeneral",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://CRAN.R-project.org/package=KSgeneral"], None},
  ButtonNote->"https://CRAN.R-project.org/package=KSgeneral"],
 ". Unlike most existing implementations, which require continuous data and \
equal sample sizes, this function handles arbitrary continuous, discrete, or \
mixed data including ties; see Maag and Stephens (1968) and Hirakawa (1973) \
for the equal-sample-size continuous case."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.990019060269285*^9, 3.990019067052967*^9}, {
  3.9900204123255844`*^9, 3.990020412731983*^9}, {3.99002044951503*^9, 
  3.99002044951503*^9}},
 CellID->13359447,ExpressionUUID->"b1772f95-92f7-494d-8994-28b4f1c3da72"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Examples",
 Cell[BoxData[
  PaneSelectorBox[{True->
   TemplateBox[{"Examples", 
     Cell[
      BoxData[
       FrameBox[
        Cell[
         TextData[{
          "Demonstrate the function\[CloseCurlyQuote]s usage, starting with \
the most basic use case and describing each example in a preceding text cell.\
\n\nWithin a group, individual examples can be delimited by inserting page \
breaks between them (either using ", 
           Cell[
            BoxData[
             StyleBox[
              TemplateBox[{
                StyleBox[
                "\"[Right-click]\"", FontFamily -> "Source Sans Pro", 
                 FontWeight -> "SemiBold", FontColor -> GrayLevel[0.28627], 
                 FontSize -> 14, StripOnInput -> False], 
                StyleBox[
                "\" \[FilledRightTriangle] \"", FontFamily -> 
                 "Source Sans Pro", FontSize -> 13.86, FontColor -> 
                 GrayLevel[0.5], StripOnInput -> False], 
                StyleBox[
                "\"Insert Page Break\"", FontFamily -> "Source Sans Pro", 
                 FontWeight -> "SemiBold", FontColor -> GrayLevel[0.28627], 
                 FontSize -> 14, StripOnInput -> False]}, "RowDefault"], 
              ShowStringCharacters -> False]]], 
           " between cells or through the menu using ", 
           Cell[
            BoxData[
             StyleBox[
              TemplateBox[{
                StyleBox[
                "\"Insert\"", FontFamily -> "Source Sans Pro", FontWeight -> 
                 "SemiBold", FontColor -> GrayLevel[0.28627], FontSize -> 14, 
                 StripOnInput -> False], 
                StyleBox[
                "\" \[FilledRightTriangle] \"", FontFamily -> 
                 "Source Sans Pro", FontSize -> 13.86, FontColor -> 
                 GrayLevel[0.5], StripOnInput -> False], 
                StyleBox[
                "\"Page Break\"", FontFamily -> "Source Sans Pro", FontWeight -> 
                 "SemiBold", FontColor -> GrayLevel[0.28627], FontSize -> 14, 
                 StripOnInput -> False]}, "RowDefault"], ShowStringCharacters -> 
              False]]], 
           ").\n\nExamples should be grouped into Subsection and \
Subsubsection cells similarly to existing documentation pages. Here are some \
typical Subsection names and the types of examples they normally contain:\n  \
", 
           Cell[
            BoxData[
             StyleBox[
              TemplateBox[{
                StyleBox[
                "\"\[FilledSmallSquare] \"", FontColor -> 
