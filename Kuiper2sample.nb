Cell[CellGroupData[{

Cell[TextData[{
 "Details & Options",
 Cell[BoxData[
  PaneSelectorBox[{True->
   TemplateBox[{"Notes", 
     Cell[
      BoxData[
       FrameBox[
        Cell[
        "Give a detailed explanation of how the function is used and \
configured (e.g. acceptable input types, result formats, options \
specifications, background information). This section may include multiple \
cells, bullet lists, tables, hyperlinks and additional styles/structures as \
needed.\n\nAdd any other information that may be relevant, such as when the \
function was first discovered or how and why it is used within a given field. \
Include all relevant background or contextual information related to the \
function, its development, and its usage.", "MoreInfoText"], Background -> 
        GrayLevel[0.95], FrameMargins -> 20, FrameStyle -> GrayLevel[0.9], 
        RoundingRadius -> 5, ImageSize -> {
          Scaled[0.65], Automatic}]], "MoreInfoText", Deletable -> True, 
      CellTags -> {"SectionMoreInfoNotes"}, 
      CellMargins -> {{66, 66}, {15, 15}}]},
    "MoreInfoOpenerButtonTemplate"]}, Dynamic[
    CurrentValue[
     EvaluationNotebook[], {TaggingRules, "ResourceCreateNotebook"}]],
   ImageSize->Automatic]],ExpressionUUID->
  "9b71704a-649b-6847-884d-a1f26e5b7dee"]
}], "Subsection",
 Editable->False,
 Deletable->False,
 TaggingRules->{"TemplateGroupName" -> "Notes"},
 DefaultNewCellStyle->"Notes",
 CellTags->{"Details & Options", "Notes", "TemplateCellGroup"},
 CellID->450324809,ExpressionUUID->"2db85a81-873e-5d41-8966-12b587ad64db"],

Cell[TextData[{
 "Kuiper2sample[",
 Cell[BoxData[
  RowBox[{
   StyleBox[
    SubscriptBox[
     StyleBox["data", "TI"], 
     StyleBox["1", "TR"]], "TI"], ",", 
   StyleBox[
    SubscriptBox[
     StyleBox["data", "TI"], 
     StyleBox["2", "TR"]], "TI"]}]],
  TaggingRules->{},
  CellChangeTimes->{{3.9900189173579464`*^9, 3.990018939219532*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cbfc213e-574f-ca4a-8458-7b1ee8fec7d8"],
 "] tests the null hypothesis ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "0"], TraditionalForm]],ExpressionUUID->
  "13aaabe9-e3df-0b47-8259-883584757ef9"],
 ": F(x) = G(x) for all x against H\:2081: F(x) \[NotEqual] G(x) where F and \
G are the unknown underlying CDFs of ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox[
    StyleBox["data", "TI"], 
    StyleBox["1", "TR"]], "TI"]],
  TaggingRules->{},
  CellChangeTimes->{
   3.990009560514303*^9, 3.9900096048586617`*^9, {3.9900152274730396`*^9, 
    3.9900152405971565`*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f21915c9-4a11-9a43-be47-4131e3856b96"],
 " and ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox[
    StyleBox["data", "TI"], 
    StyleBox["2", "TR"]], "TI"]],
  TaggingRules->{},
  CellChangeTimes->{
   3.990009560514303*^9, 3.9900096048586617`*^9, {3.9900152274730396`*^9, 
    3.9900152405971565`*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2ca6d995-11b7-bb4e-b7b5-21a42395e078"],
 " respectively; both samples may come from continuous, discrete, or mixed \
distributions and may contain ties."
}], "Notes",
 TaggingRules->{},
 CellEventActions->{Inherited, {"KeyDown", "\t"} :> Replace[SelectionMove[
       SelectedNotebook[], After, Cell]; NotebookFind[
       SelectedNotebook[], "TabNext", Next, CellTags, AutoScroll -> True, 
       WrapAround -> True], Blank[NotebookSelection] :> SelectionMove[
       SelectedNotebook[], All, CellContents, AutoScroll -> True]], 
   PassEventsDown -> False, PassEventsUp -> False},
 CellChangeTimes->{
  3.990019009701092*^9, 3.990019445363695*^9, {3.9900198846423664`*^9, 
   3.990019913337496*^9}, {3.9900199663236885`*^9, 3.990019970556114*^9}, {
   3.990020002507784*^9, 3.9900200302423534`*^9}, {3.990020062217373*^9, 
   3.9900201207005577`*^9}},
 CellTags->{"DefaultContent", "TabNext"},
 CellID->422531486,ExpressionUUID->"d3870e04-9561-184e-bdd6-97ac1c0f4ffd"],

Cell[TextData[{
 "The Kuiper statistic is defined as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[FinalSigma]", 
     RowBox[{"m", ",", "n"}]], "=", 
    RowBox[{
     RowBox[{
      UnderscriptBox["sup", 
       RowBox[{"t", "\[Element]", " ", "\[DoubleStruckCapitalR]"}]], "[", 
      RowBox[{
       RowBox[{
        SubscriptBox["F", "m"], "(", "t", ")"}], "-", 
       RowBox[{
        SubscriptBox["G", "n"], "(", "t", ")"}]}], "]"}], "\[Minus]", 
     RowBox[{
      UnderscriptBox["inf", 
       RowBox[{"t", "\[Element]", " ", "\[DoubleStruckCapitalR]"}]], "[", 
      RowBox[{
       RowBox[{
        SubscriptBox["F", "m"], "(", "t", ")"}], "-", 
       RowBox[{
        SubscriptBox["G", "n"], "(", "t", ")"}]}], "]"}]}]}], 
   TraditionalForm]],ExpressionUUID->"96404926-d6e4-5048-bc47-df7eb4467cd1"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", "m"], "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "460dbad0-70ba-7f44-95fc-d9cb0f8a632a"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["G", "n"], "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "be01da02-5afa-a148-b671-b2f1eb349697"],
 " are the empirical CDF of the ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox[
    StyleBox["data", "TI"], 
    StyleBox["1", "TR"]], "TI"]],
  TaggingRules->{},
  CellChangeTimes->{
   3.990009560514303*^9, 3.9900096048586617`*^9, {3.9900152274730396`*^9, 
    3.9900152405971565`*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "09582a12-cf31-c34d-bef5-695fbd999309"],
 " and ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox[
    StyleBox["data", "TI"], 
    StyleBox["2", "TR"]], "TI"]],
  TaggingRules->{},
  CellChangeTimes->{
   3.990009560514303*^9, 3.9900096048586617`*^9, {3.9900152274730396`*^9, 
    3.9900152405971565`*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "02a7c1a5-b1d8-844e-9192-0eea6f4b7eb4"],
 ". It is invariant to cyclic shifts, making it ideal for circular and \
seasonal data and uniformly sensitive across the full support of the \
distribution."
}], "Notes",
 TaggingRules->{},
 CellEventActions->{Inherited, {"KeyDown", "\t"} :> Replace[SelectionMove[
       SelectedNotebook[], After, Cell]; NotebookFind[
       SelectedNotebook[], "TabNext", Next, CellTags, AutoScroll -> True, 
       WrapAround -> True], Blank[NotebookSelection] :> SelectionMove[
       SelectedNotebook[], All, CellContents, AutoScroll -> True]], 
   PassEventsDown -> False, PassEventsUp -> False},
 CellChangeTimes->{{3.990019009701092*^9, 3.9900190209013176`*^9}, {
  3.9900201303161545`*^9, 3.9900201707407207`*^9}},
 CellTags->{"DefaultContent", "TabNext"},
 CellID->49355424,ExpressionUUID->"31024af5-633f-934e-933e-c0caa9be6b82"],

Cell[TextData[{
 "The p-value is the exact conditional probability ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "(", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", 
       RowBox[{"m", "+", "n"}]], "\[GreaterEqual]", 
      StyleBox["q", "TI"]}], 
     StyleBox["|", "TI"], 
     SubscriptBox[
      StyleBox["Z",
       FontWeight->"Bold"], 
      RowBox[{"m", "+", "n"}]]}], ")"}], TraditionalForm]],ExpressionUUID->
  "bc0a1093-e9c9-964b-9cb9-3e8978ea89b8"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["V", 
    RowBox[{"m", "+", "n"}]], TraditionalForm]],ExpressionUUID->
  "f29e34db-3eea-9c42-92ff-69e36c3853eb"],
 " is permutation version of the Kuiper statistic ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[FinalSigma]", 
    RowBox[{"m", ",", "n"}]], TraditionalForm]],ExpressionUUID->
  "18a461b3-7e20-1c43-b01c-c63148f54c9e"],
 " obtained by randomly repartitioning the pooled sample ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["Z",
      FontWeight->"Bold"], 
     RowBox[{"m", "+", "n"}]], "=", 
    RowBox[{"{", 
     RowBox[{
      StyleBox[
       SubscriptBox[
        StyleBox["data", "TI"], 
        StyleBox["1", "TR"]], "TI"], ",", 
      StyleBox[
       SubscriptBox[
        StyleBox["data", "TI"], 
        StyleBox["2", "TR"]], "TI"]}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"ba0b466f-8f6a-6843-a820-a19c93ff225e"],
 " into two groups of sizes ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0daebb0b-0a52-9b4b-bb38-2dc60b6e424b"],
 " and ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2b2c3c94-7c68-0a4a-996a-f9e3820a21ee"],
 "."
}], "Notes",
 TaggingRules->{},
 CellEventActions->{Inherited, {"KeyDown", "\t"} :> Replace[SelectionMove[
       SelectedNotebook[], After, Cell]; NotebookFind[
       SelectedNotebook[], "TabNext", Next, CellTags, AutoScroll -> True, 
       WrapAround -> True], Blank[NotebookSelection] :> SelectionMove[
       SelectedNotebook[], All, CellContents, AutoScroll -> True]], 
   PassEventsDown -> False, PassEventsUp -> False},
 CellChangeTimes->{{3.990019009701092*^9, 3.9900190209013176`*^9}, {
   3.9900201303161545`*^9, 3.9900201707407207`*^9}, 3.9900203098846283`*^9, {
   3.990020382217966*^9, 3.990020384444765*^9}},
 CellTags->{"DefaultContent", "TabNext"},
 CellID->309935745,ExpressionUUID->"8296670a-222e-ff4b-9105-60c8a7071c6e"],

Cell[TextData[{
 "The data-interface form Kuiper2sample[",
 Cell[BoxData[
  RowBox[{
   StyleBox[
    SubscriptBox[
     StyleBox["data", "TI"], 
     StyleBox["1", "TR"]], "TI"], ",", 
   StyleBox[
    SubscriptBox[
     StyleBox["data", "TI"], 
     StyleBox["2", "TR"]], "TI"]}]],
  TaggingRules->{},
  CellChangeTimes->{{3.9900189173579464`*^9, 3.990018939219532*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d40f8aa3-4f29-cd45-9e2c-0b48036ce111"],
 "] returns the list {",
 Cell[BoxData[
  RowBox[{
   StyleBox["v", "TI"], ",", 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fec47e5d-ebe2-d548-93d6-184f44ba68fd"],
 "} where v is the observed Kuiper statistic and p is the exact rational \
p-value. The low-level form Kuiper2sample[",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], ",", 
   StyleBox["n", "TI"], ",", "M", ",", 
   StyleBox["q", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "89086faf-d00b-2343-a637-26dc52e8e956"],
 "] returns only the p-value."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{
  3.990019031061001*^9, {3.990019456083851*^9, 3.9900194626361885`*^9}},
 CellID->124384718,ExpressionUUID->"0cee6a25-cf40-c847-8c1a-fc96a7cf0021"],

Cell[TextData[{
 "In the low-level form, ",
 Cell[BoxData[
  StyleBox["multiplicity", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ad9f3393-f930-2b4a-acb8-572870d595b2"],
 " is an integer list of length k (the number of distinct values in the \
pooled sample) where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["multiplicity", "TI"], "[", 
   RowBox[{"[", 
    StyleBox["i", "TI"], "]"}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b1a94cb4-97ff-194c-9033-22b92480bbe0"],
 " is the number of times the i-th distinct pooled-sample value appears; ",
 Cell[BoxData[
  RowBox[{
   TagBox[
    ButtonBox[
     StyleBox["Total", "SymbolsRefLink",
      ShowStringCharacters->True,
      FontFamily->"Source Sans Pro"],
     BaseStyle->Dynamic[
       FEPrivate`If[
        CurrentValue["MouseOver"], {
        "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
     ButtonData->"paclet:ref/Total",
     ContentPadding->False],
    MouseAppearanceTag["LinkHand"]], "[", 
   StyleBox["multiplicity", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3f7d497b-c91e-b642-bb75-cb45dae836fd"],
 " must equal ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "+", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d77d789f-6a74-3649-8862-3ea8b3ca5ee7"],
 ". When there are no ties, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["multiplicity", "TI"], "=", 
   RowBox[{
    TagBox[
     ButtonBox[
      StyleBox["ConstantArray", "SymbolsRefLink",
       ShowStringCharacters->True,
       FontFamily->"Source Sans Pro"],
      BaseStyle->Dynamic[
        FEPrivate`If[
         CurrentValue["MouseOver"], {
         "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
      ButtonData->"paclet:ref/ConstantArray",
      ContentPadding->False],
     MouseAppearanceTag["LinkHand"]], "[", 
    RowBox[{"1", ",", 
     RowBox[{
      StyleBox["m", "TI"], "+", 
      StyleBox["n", "TI"]}]}], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "21bf55b9-103c-ef47-ae7a-a5dd7c31e0ba"],
 ". ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d3fcf457-3321-f34a-9118-31948dc00497"],
 " must lie in[0, 2]."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.990019035708292*^9, 3.9900190395801697`*^9}, {
   3.9900194711535816`*^9, 3.99001948802516*^9}, {3.9900254913541203`*^9, 
   3.9900255314576683`*^9}, 3.990031840856859*^9},
 CellID->64091601,ExpressionUUID->"b3296897-ab55-cc41-9102-258622cb759e"],

Cell[TextData[{
 "The p-value ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "(", 
    RowBox[{
     SubscriptBox["V", 
      RowBox[{"m", "+", "n"}]], "\[GreaterEqual]", 
     StyleBox["q", "TI"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "19443d68-a64a-2946-adcd-2e4888828aef"],
 " is computed via the permutation formulation of Proposition 2 of Dimitrova, \
Jia, Kaishev (2026), which expresses N\[Prime] as an alternating sum of \
one-sided trajectory counts N(a, b), each computed by the KS recurrence with \
asymmetric bounds. The simplified formula of Remark 2.3 of Dimitrova, Jia, \
Kaishev (2026) is used when ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "257b4d74-1bf4-114a-a610-f0a34a4c7643"],
 " > 1."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{
  3.9900190470685043`*^9, {3.990020198855982*^9, 3.9900202146221066`*^9}, {
   3.990020259780657*^9, 3.9900202648923016`*^9}, {3.9900203046521053`*^9, 
   3.9900203506019707`*^9}, 3.990020405067301*^9},
 CellID->483646850,ExpressionUUID->"152714b8-a437-f94e-ad75-ded15becef3f"],

Cell[TextData[{
 "The worst-case complexity is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    RowBox[{
     StyleBox["mn", "TI"], "*", "r"}], ")"}], TraditionalForm]],
  ExpressionUUID->"11cfbcf6-ca15-e547-af1a-8c85f8d2674e"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "="}], TraditionalForm]],ExpressionUUID->
  "664a92ae-1dad-ce45-8d10-7f1b65256feb"],
 " ",
 Cell[BoxData[
  RowBox[{
   TagBox[
    ButtonBox[
     StyleBox["GCD", "SymbolsRefLink",
      ShowStringCharacters->True,
      FontFamily->"Source Sans Pro"],
     BaseStyle->Dynamic[
       FEPrivate`If[
        CurrentValue["MouseOver"], {
        "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
     ButtonData->"paclet:ref/GCD",
     ContentPadding->False],
    MouseAppearanceTag["LinkHand"]], "[", 
   RowBox[{
    StyleBox["m", "TI"], ",", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "88d5439b-d88f-e943-bb5b-65bbedbf6c1c"],
 "; when ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "f07c16f3-6a61-9d49-9137-a769b8cc3020"],
 " is large (e.g. ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "=", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7cf49a04-e16b-374d-b008-ccb12155795b"],
 "), it reduces to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "m\.b2n", ")"}], TraditionalForm]],ExpressionUUID->
  "47d494cd-e5eb-344b-8b30-76a7553db4a8"],
 "."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{
  3.9900190550927143`*^9, {3.9900195099288826`*^9, 3.9900195336827507`*^9}, {
   3.990019792550598*^9, 3.990019841500824*^9}},
 CellID->470673315,ExpressionUUID->"e533f334-c01e-fc44-9ba6-5d376fe07ef5"],

Cell[TextData[{
 "This is the Mathematica counterpart of ",
 StyleBox["Kuiper2sample",
  FontVariations->{"Underline"->True}],
 " and ",
 StyleBox["Kuiper2sample_Rcpp",
  FontVariations->{"Underline"->True}],
 " in the R package ",
 ButtonBox["KSgeneral",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://CRAN.R-project.org/package=KSgeneral"], None},
  ButtonNote->"https://CRAN.R-project.org/package=KSgeneral"],
 ". Unlike most existing implementations, which require continuous data and \
equal sample sizes, this function handles arbitrary continuous, discrete, or \
mixed data including ties; see Maag and Stephens (1968) and Hirakawa (1973) \
for the equal-sample-size continuous case."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.990019060269285*^9, 3.990019067052967*^9}, {
  3.9900204123255844`*^9, 3.990020412731983*^9}, {3.99002044951503*^9, 
  3.99002044951503*^9}},
 CellID->13359447,ExpressionUUID->"6359d436-6029-6d49-8284-6aa2a7efaef0"]
}, Open  ]]
}, Open  ]],

