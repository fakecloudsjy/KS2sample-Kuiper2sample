Cell[TextData[{
 "Returns ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["v", "TI"], ",", 
    StyleBox["p", "TI"]}], "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fab02f19-0baf-3047-a14c-bff5074fbda7"],
 ", the observed Kuiper statistic and exact p-value, for samples ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox[
    StyleBox["data", "TI"], 
    StyleBox["1", "TR"]], "TI"]],
  CellChangeTimes->{{3.9900189173579464`*^9, 3.990018939219532*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "61c7f54e-4a25-7542-bbb3-66b17e0f8924"],
 " and ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox[
    StyleBox["data", "TI"], 
    StyleBox["2", "TR"]], "TI"]],
  CellChangeTimes->{{3.9900189173579464`*^9, 3.990018939219532*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8cf7b540-dec8-4942-bf4a-9561a2c86e19"],
 "."
}], "UsageDescription",
 TaggingRules->{},
 CellChangeTimes->{{3.9900189240450954`*^9, 3.990018955453808*^9}},
 CellTags->{"DefaultContent", "TabNext"},
 CellID->746063541,ExpressionUUID->"a57e03f4-a036-0e41-b548-54d811632ea8"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Kuiper2sample", "[", 
  RowBox[{
   StyleBox["m", "TI"], ",", 
   StyleBox["n", "TI"], ",", 
   StyleBox["q", "TI"]}], "]"}]], "UsageInputs",
