  FontFamily->"Source Sans Pro",ExpressionUUID->
  "da47aad5-9a80-4a49-95c9-0ce0ca460d18"],
 ". When ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["m", "TI"], "=", 
    StyleBox["n", "TI"]}], ",", 
   RowBox[{
    RowBox[{
     TagBox[
