Cell["\<\
The Titanic dataset is built into Mathematica and contains 1309 passengers \
whose ages are recorded to one decimal place, producing heavy ties. We test \
whether the age distribution of survivors differs from that of non-survivors:\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.990011606008587*^9, 3.990011657544691*^9}, {
   3.99001169003216*^9, 3.990011698287449*^9}, {3.9900153199848557`*^9, 
   3.9900153228547096`*^9}, {3.990027872498316*^9, 3.990027880903473*^9}, 
   3.990028629042616*^9},
 CellTags->"DefaultContent",
 CellID->29590629,ExpressionUUID->"ae2e5264-6416-d941-9863-a05e64c3a1f6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"titanic", "=", 
   RowBox[{"Normal", "@", 
    RowBox[{"ExampleData", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<Dataset\>\"", ",", "\"\<Titanic\>\""}], "}"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"survived", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"#", "[", "\"\<age\>\"", "]"}], "&"}], "/@", 
    RowBox[{"Select", "[", 
     RowBox[{"titanic", ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<survived\>\"", "]"}], "===", "True"}], "&&", 
        RowBox[{"NumberQ", "[", 
         RowBox[{"#", "[", "\"\<age\>\"", "]"}], "]"}]}], "&"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"notsurvived", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"#", "[", "\"\<age\>\"", "]"}], "&"}], "/@", 
    RowBox[{"Select", "[", 
     RowBox[{"titanic", ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<survived\>\"", "]"}], "===", "False"}], "&&", 
        RowBox[{"NumberQ", "[", 
         RowBox[{"#", "[", "\"\<age\>\"", "]"}], "]"}]}], "&"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", "survived", "]"}], ",", 
   RowBox[{"Length", "[", "notsurvived", "]"}]}], "}"}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.9900320590804024`*^9, 3.990032068536314*^9}},
 CellLabel->"In[14]:=",
 CellID->1061257,ExpressionUUID->"1cd416ff-a1db-cb4c-89d3-315045776ff2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"427", ",", "619"}], "}"}]], "Output",
 TaggingRules->{},
 CellChangeTimes->{3.990032070536501*^9},
 CellLabel->"Out[17]=",
 CellID->44536164,ExpressionUUID->"4535ea21-a7de-cd49-b585-f1fe789dafbc"]
}, Open  ]],

