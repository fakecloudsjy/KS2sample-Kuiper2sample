  "ae775322-56ba-1d40-97ad-c4c806b01b0a"]
}], "Subsection",
 Editable->False,
 Deletable->False,
 TaggingRules->{"TemplateGroupName" -> "Notes"},
 DefaultNewCellStyle->"Notes",
 CellTags->{"Details & Options", "Notes", "TemplateCellGroup"},
 CellID->450324809,ExpressionUUID->"074d4cc8-2b48-0a4f-9177-242d5740ed30"],

Cell[TextData[{
 "KS2sample[",
 Cell[BoxData[
  RowBox[{
   StyleBox[
    SubscriptBox[
     StyleBox["data", "TI"], 
     StyleBox["1", "TR"]], "TI"], ",", 
   StyleBox[
    SubscriptBox[
     StyleBox["data", "TI"], 
     StyleBox["2", "TR"]], "TI"]}]],
  TaggingRules->{},
  CellChangeTimes->{
   3.990009560514303*^9, 3.9900096048586617`*^9, {3.9900152274730396`*^9, 
    3.9900152405971565`*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "db232b62-9f18-2e42-9330-9c6c62d13151"],
 ", \[Ellipsis]] tests the null hypothesis ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "0"], TraditionalForm]],ExpressionUUID->
  "a4be161c-5e85-e143-a271-58d9111ca829"],
 ": F(x) = G(x) for all x, where F and G are the unknown underlying CDFs of ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox[
    StyleBox["data", "TI"], 
    StyleBox["1", "TR"]], "TI"]],
  TaggingRules->{},
  CellChangeTimes->{
   3.990009560514303*^9, 3.9900096048586617`*^9, {3.9900152274730396`*^9, 
    3.9900152405971565`*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bcc3b001-2b15-504f-a7c6-544bf49a8d38"],
 " and ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox[
    StyleBox["data", "TI"], 
    StyleBox["2", "TR"]], "TI"]],
  TaggingRules->{},
  CellChangeTimes->{
   3.990009560514303*^9, 3.9900096048586617`*^9, {3.9900152274730396`*^9, 
    3.9900152405971565`*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "201c75cd-0216-514b-b2a1-b87199d2ee9a"],
 " respectively; both samples may come from continuous, discrete, or mixed \
distributions and may contain repeated observations (ties)."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.9900097059292297`*^9, 3.990009706792824*^9}, {
   3.990013287565853*^9, 3.990013292308344*^9}, 3.9900152712948627`*^9, {
   3.990016035754484*^9, 3.9900160559872723`*^9}},
 CellID->4711060,ExpressionUUID->"e72b8a60-6a3d-0e4b-8a09-05f876f48d7f"],

Cell[TextData[{
 "The two-sample KS statistics are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]", 
     RowBox[{"m", ",", "n"}]], "=", 
    RowBox[{
     UnderscriptBox["sup", 
      RowBox[{"t", " ", "\[Element]", " ", "\[DoubleStruckCapitalR]"}]], 
     TemplateBox[{
       RowBox[{
         RowBox[{
           SubscriptBox["F", "m"], "(", "t", ")"}], "-", 
         RowBox[{
           SubscriptBox["G", "n"], "(", "t", ")"}]}]},
      "Abs"], " ", 
     RowBox[{"W", "(", 
      RowBox[{
       SubscriptBox["E", 
        RowBox[{"m", "+", "n"}]], "\[InvisibleApplication]", 
       RowBox[{"(", "t", ")"}]}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "95fed8d7-bfa5-3f47-9c82-c523707a3332"],
 " (two-sided), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["\[CapitalDelta]", 
      RowBox[{"m", ",", "n"}]], "+"], "=", 
    RowBox[{
     RowBox[{
      UnderscriptBox["sup", 
       RowBox[{"t", "\[Element]", " ", "\[DoubleStruckCapitalR]"}]], "[", 
      RowBox[{
       RowBox[{
        SubscriptBox["F", "m"], "(", "t", ")"}], "-", 
       RowBox[{
        SubscriptBox["G", "n"], "(", "t", ")"}]}], "]"}], 
     RowBox[{"W", "(", 
      RowBox[{
       SubscriptBox["E", 
        RowBox[{"m", "+", "n"}]], "\[InvisibleApplication]", 
       RowBox[{"(", "t", ")"}]}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "5b859bbd-9d00-634c-a584-59dfd16da2fc"],
 " (one-sided greater), and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["\[CapitalDelta]", 
      RowBox[{"m", ",", "n"}]], "-"], "=", 
    RowBox[{
     RowBox[{
      UnderscriptBox["sup", 
       RowBox[{"t", " ", "\[Element]", " ", "\[DoubleStruckCapitalR]"}]], "[", 
      RowBox[{
       RowBox[{
        SubscriptBox["G", "n"], "(", "t", ")"}], "-", 
       RowBox[{
        SubscriptBox["F", "m"], "(", "t", ")"}]}], "]"}], 
     RowBox[{"W", "(", 
      RowBox[{
       SubscriptBox["E", 
        RowBox[{"m", "+", "n"}]], "\[InvisibleApplication]", 
       RowBox[{"(", "t", ")"}]}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "979e08c0-741c-444c-b4b0-26f7a829e040"],
 " (one-sided less), where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", "m"], "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "8e009a06-5b09-de44-a5cd-64bd9c24cd37"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["G", "n"], "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "7c9d2b30-a816-6e4f-8c80-2aff2b72bf5b"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["E", 
     RowBox[{"m", "+", "n"}]], "\[InvisibleApplication]", 
    RowBox[{"(", "t", ")"}]}], TraditionalForm]],ExpressionUUID->
  "19da0cee-cdeb-974c-a846-97a69d97b778"],
 " are the empirical CDF of the ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox[
    StyleBox["data", "TI"], 
    StyleBox["1", "TR"]], "TI"]],
  TaggingRules->{},
  CellChangeTimes->{
   3.990009560514303*^9, 3.9900096048586617`*^9, {3.9900152274730396`*^9, 
    3.9900152405971565`*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "579a7914-0b2c-0647-8de7-5c9ea7fd7689"],
 ", ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox[
    StyleBox["data", "TI"], 
    StyleBox["2", "TR"]], "TI"]],
  TaggingRules->{},
  CellChangeTimes->{
   3.990009560514303*^9, 3.9900096048586617`*^9, {3.9900152274730396`*^9, 
    3.9900152405971565`*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ab56462b-9eed-8c4e-9044-e5044f1b6a9e"],
 " and the pooled sample ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["Z",
      FontWeight->"Bold"], 
     RowBox[{"m", "+", "n"}]], "="}], TraditionalForm]],ExpressionUUID->
  "d85e7875-5370-7f45-a6b2-48c5df3e22a2"],
 "{",
 Cell[BoxData[
  StyleBox[
   SubscriptBox[
    StyleBox["data", "TI"], 
    StyleBox["1", "TR"]], "TI"]],
  TaggingRules->{},
  CellChangeTimes->{
   3.990009560514303*^9, 3.9900096048586617`*^9, {3.9900152274730396`*^9, 
    3.9900152405971565`*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "95577ccc-8029-ab4c-b0ed-192230a31791"],
 ", ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox[
    StyleBox["data", "TI"], 
    StyleBox["2", "TR"]], "TI"]],
  TaggingRules->{},
  CellChangeTimes->{
   3.990009560514303*^9, 3.9900096048586617`*^9, {3.9900152274730396`*^9, 
    3.9900152405971565`*^9}},
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1ba443b6-47b0-d248-ab02-f21a13a66d3c"],
 "} respectively and ",
 Cell[BoxData["W"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "72b24776-3ba9-3e40-a823-91231bef66ca"],
 " is the weight function."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{
  3.9900097237539177`*^9, 3.9900158223794937`*^9, {3.9900160618164005`*^9, 
   3.990016102646204*^9}, {3.9900162173280106`*^9, 3.990016313581581*^9}, {
   3.990016358474106*^9, 3.9900165350840645`*^9}, {3.9900165890997295`*^9, 
   3.9900166165101967`*^9}, {3.9900166730330677`*^9, 
   3.9900167450841923`*^9}, {3.9900167968658257`*^9, 
   3.9900169135958633`*^9}, {3.9900169500680065`*^9, 3.990017179425146*^9}, {
   3.9900181824046326`*^9, 3.99001819443058*^9}, {3.9900183857164*^9, 
   3.990018396580681*^9}},
 CellID->163682815,ExpressionUUID->"c9ea7a62-97b8-4e40-a7b9-8e06c84d0352"],

Cell[TextData[{
 "The alternative \"TwoSided\" uses ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    RowBox[{"m", ",", "n"}]], TraditionalForm]],ExpressionUUID->
  "6587a9f7-61ca-e24e-a23e-5a0ec50c45db"],
 "; \"Greater\" uses ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[CapitalDelta]", 
     RowBox[{"m", ",", "n"}]], "+"], TraditionalForm]],ExpressionUUID->
  "6bdd04c4-ea9b-7247-9897-1aa86a68d52b"],
 " to test ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "1"], TraditionalForm]],ExpressionUUID->
  "d6219f23-e9fa-7c43-a623-97fe03272c97"],
 ": F(x) > G(x); \"Less\" uses ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[CapitalDelta]", 
     RowBox[{"m", ",", "n"}]], "-"], TraditionalForm]],ExpressionUUID->
  "ce689fa0-6b19-9240-a0fe-ae610b54ec4c"],
 " to test ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "1"], TraditionalForm]],ExpressionUUID->
  "c7e0cc13-6faf-5d46-87c1-bca5b4bc1e7c"],
 ": F(x) < G(x).",
 Cell[BoxData[
  RowBox[{
   StyleBox["weight", "TI"], "=", 
   RowBox[{
    TagBox[
     ButtonBox[
      StyleBox["Function", "SymbolsRefLink",
       ShowStringCharacters->True,
       FontFamily->"Source Sans Pro"],
      BaseStyle->Dynamic[
        FEPrivate`If[
         CurrentValue["MouseOver"], {
         "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
      ButtonData->"paclet:ref/Function",
      ContentPadding->False],
     MouseAppearanceTag["LinkHand"]], "[", 
    RowBox[{
     StyleBox["t", "TI"], ",", 
     RowBox[{"1", "/", 
      RowBox[{
       TagBox[
        ButtonBox[
         StyleBox["Sqrt", "SymbolsRefLink",
          ShowStringCharacters->True,
          FontFamily->"Source Sans Pro"],
         BaseStyle->Dynamic[
           FEPrivate`If[
            CurrentValue["MouseOver"], {
            "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {
            "Link"}]],
         ButtonData->"paclet:ref/Sqrt",
         ContentPadding->False],
        MouseAppearanceTag["LinkHand"]], "[", 
       RowBox[{
        StyleBox["t", "TI"], 
        RowBox[{"(", 
         RowBox[{"2", "-", 
          StyleBox["t", "TI"]}], ")"}]}], "]"}]}]}], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "59911281-0df2-e841-b4b0-f07f927d1941"]
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{
  3.9900097237539177`*^9, 3.9900101670174294`*^9, {3.990017164133692*^9, 
   3.990017207666649*^9}, 3.9900176085319347`*^9},
 CellID->289768328,ExpressionUUID->"616bebb3-c8ff-504e-9cf5-e8965407df6e"],

Cell[TextData[{
 "weight = 0 gives the standard unweighted KS test (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"W", "(", "t", ")"}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"2fcaef4d-6920-7f4a-8c58-ecd022a21e4b"],
 "). weight = \[Nu] for \[Nu] \[Element] (0, 1] gives the parametric family ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{
     RowBox[{
      RowBox[{"W", "(", "t", ")"}], " ", "=", " ", 
      RowBox[{"1", "/", 
       RowBox[{"[", 
        RowBox[{"t", 
         RowBox[{"(", 
          RowBox[{"1", "\[Minus]", "t"}], ")"}]}], "]"}]}]}], ")"}], "\[Nu]"],
    TraditionalForm]],ExpressionUUID->"7e51da52-9554-d14f-8cc7-aec558312ce0"],
 " due to Finner and Gontscharuk (2018); \[Nu] = 0.5 recovers the \
Anderson-Darling weight of Canner (1975). A user-supplied function enables \
arbitrary weights, e.g. ",
 Cell[BoxData[
  RowBox[{
   StyleBox["weight", "TI"], "=", 
   RowBox[{
    TagBox[
     ButtonBox[
      StyleBox["Function", "SymbolsRefLink",
       ShowStringCharacters->True,
       FontFamily->"Source Sans Pro"],
      BaseStyle->Dynamic[
        FEPrivate`If[
         CurrentValue["MouseOver"], {
         "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
      ButtonData->"paclet:ref/Function",
      ContentPadding->False],
     MouseAppearanceTag["LinkHand"]], "[", 
    RowBox[{
     StyleBox["t", "TI"], ",", 
     RowBox[{"1", "/", 
      RowBox[{
       TagBox[
        ButtonBox[
         StyleBox["Sqrt", "SymbolsRefLink",
          ShowStringCharacters->True,
          FontFamily->"Source Sans Pro"],
         BaseStyle->Dynamic[
           FEPrivate`If[
            CurrentValue["MouseOver"], {
            "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {
            "Link"}]],
         ButtonData->"paclet:ref/Sqrt",
         ContentPadding->False],
        MouseAppearanceTag["LinkHand"]], "[", 
       RowBox[{
        StyleBox["t", "TI"], 
        RowBox[{"(", 
         RowBox[{"2", "-", 
          StyleBox["t", "TI"]}], ")"}]}], "]"}]}]}], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ba773009-8956-ff41-b124-54c842bee783"],
 " for the B\[UDoubleDot]ning (2001) weight suited to left-skewed \
heavy-tailed data."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{
  3.9900097237539177`*^9, {3.9900101670174294`*^9, 3.9900102008265495`*^9}, {
   3.9900172180273075`*^9, 3.990017258553936*^9}, {3.990017613047636*^9, 
   3.9900176200687428`*^9}},
 CellID->218697362,ExpressionUUID->"44b2474f-6d62-8d4c-a98e-12a773bfe1bd"],

Cell[TextData[{
 "The data-interface form KS2sample[",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["data", "TI"], 
   StyleBox["1", "TR"]]],ExpressionUUID->
  "ed889dc2-7a2a-5b42-8b61-256269219687"],
 ", ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["data", "TI"], 
   StyleBox["2", "TR"]]],ExpressionUUID->
  "b82413f0-c9d4-fe4f-9112-a818830c3d05"],
 ", \[Ellipsis]] returns the list {",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], ",", 
   StyleBox["p", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "74730aad-258f-e74d-aa2f-61fe96ffd5ed"],
 "} where ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f0c71a40-b438-3044-b61e-8ece6dbdf246"],
 " is the observed KS statistic and ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c7fd17c4-a79e-a74d-b60c-62eb05088fe3"],
 " is the exact rational p-value. The low-level form KS2sample[",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], ",", 
   StyleBox["n", "TI"], ",", 
   StyleBox["alternative", "TI"], ",", "M", ",", 
   StyleBox["q", "TI"], ",", 
   StyleBox["wvec", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0389f158-93f4-404b-957d-b038cb81962e"],
 "] returns only the p-value as an exact rational number."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{
  3.9900097237539177`*^9, {3.9900101670174294`*^9, 3.9900101788739166`*^9}, 
   3.9900102145536537`*^9, 3.9900113342811317`*^9, {3.9900153707532845`*^9, 
   3.9900153707996616`*^9}, {3.9900172735919495`*^9, 3.990017291964731*^9}},
 CellID->139013865,ExpressionUUID->"a2ef7d85-322a-6542-89a1-f4e0d577e9dc"],

Cell[TextData[{
 "In the low-level form, M is an integer list of length k (the number of \
distinct values in the pooled sample) where ",
 Cell[BoxData[
  RowBox[{"M", "[", 
   RowBox[{"[", 
    StyleBox["i", "TI"], "]"}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "41cc2c3a-a3fb-644b-8687-a5b38019a291"],
 " is the number of times the i-th distinct pooled-sample value appears; ",
 Cell[BoxData[
  RowBox[{
   TagBox[
    ButtonBox[
     StyleBox["Total", "SymbolsRefLink",
      ShowStringCharacters->True,
      FontFamily->"Source Sans Pro"],
     BaseStyle->Dynamic[
       FEPrivate`If[
        CurrentValue["MouseOver"], {
        "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
     ButtonData->"paclet:ref/Total",
     ContentPadding->False],
    MouseAppearanceTag["LinkHand"]], "[", "M", "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d39ce633-5f6f-f342-82ac-1a440b562ad6"],
 " must equal ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "+", 
   StyleBox["n", "TI"]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d4c9b91a-7adf-8841-a602-189a58cf8c80"],
 ". When there are no ties, ",
 Cell[BoxData[
  RowBox[{"M", "=", 
   RowBox[{
    TagBox[
     ButtonBox[
      StyleBox["ConstantArray", "SymbolsRefLink",
       ShowStringCharacters->True,
       FontFamily->"Source Sans Pro"],
      BaseStyle->Dynamic[
        FEPrivate`If[
         CurrentValue["MouseOver"], {
         "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
      ButtonData->"paclet:ref/ConstantArray",
      ContentPadding->False],
     MouseAppearanceTag["LinkHand"]], "[", 
    RowBox[{"1", ",", 
     RowBox[{
      StyleBox["m", "TI"], "+", 
      StyleBox["n", "TI"]}]}], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e4ac000e-8a26-0a43-ae11-dbc22a4f05e2"],
 ". ",
 Cell[BoxData[
  StyleBox["wvec", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "16ac669a-70b5-704d-b264-ca81dc25f0d3"],
 " has length ",
 Cell[BoxData[
  RowBox[{
   StyleBox["m", "TI"], "+", 
   StyleBox["n", "TI"], "\[Minus]", "1"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "baaf5e16-677f-0543-a96e-0b87200b10cf"],
 " with ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["wvec", "TI"], "[", 
    RowBox[{"[", 
     StyleBox["i", "TI"], "]"}], "]"}], "=", 
   RowBox[{"W", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], "/", 
      RowBox[{"(", 
       RowBox[{
        StyleBox["m", "TI"], "+", 
        StyleBox["n", "TI"]}], ")"}]}], ")"}]}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cf80ad29-1df9-ce47-bbf1-b1e4e7b75553"],
 "; the unweighted case is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["wvec", "TI"], "=", 
   RowBox[{
    TagBox[
     ButtonBox[
      StyleBox["ConstantArray", "SymbolsRefLink",
       ShowStringCharacters->True,
       FontFamily->"Source Sans Pro"],
      BaseStyle->Dynamic[
        FEPrivate`If[
         CurrentValue["MouseOver"], {
         "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
      ButtonData->"paclet:ref/ConstantArray",
      ContentPadding->False],
     MouseAppearanceTag["LinkHand"]], "[", 
    RowBox[{"1", ",", 
     RowBox[{
      StyleBox["m", "TI"], "+", 
      StyleBox["n", "TI"], "\[Minus]", "1"}]}], "]"}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ee6f8de8-9215-1a4c-9c7e-2f6975a93650"],
 "."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{
  3.9900102248973637`*^9, 3.9900113638006268`*^9, {3.990017302376993*^9, 
   3.9900173408887024`*^9}},
 CellID->362728295,ExpressionUUID->"59abc22a-c6af-c84a-accb-7791f5dbf250"],

Cell[TextData[{
 "The p-value is the exact conditional probability ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "(", 
    RowBox[{
     RowBox[{
      SubscriptBox["D", 
       RowBox[{"m", "+", "n"}]], "\[GreaterEqual]", 
      StyleBox["q", "TI"]}], 
     StyleBox["|", "TI"], 
     SubscriptBox[
      StyleBox["Z",
       FontWeight->"Bold"], 
      RowBox[{"m", "+", "n"}]]}], ")"}], TraditionalForm]],ExpressionUUID->
  "ca869492-f073-e34b-9326-0f85d4c6f95c"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", 
    RowBox[{"m", "+", "n"}]], TraditionalForm]],ExpressionUUID->
  "0e213829-efb1-d148-8868-1a4d3df6f3cb"],
 " is permutation version of the selected KS statistic (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", 
    RowBox[{"m", ",", "n"}]], TraditionalForm]],ExpressionUUID->
  "650e41ca-2f93-854f-af08-e8bf5e2b073f"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[CapitalDelta]", 
     RowBox[{"m", ",", "n"}]], "+"], TraditionalForm]],ExpressionUUID->
  "4ae2bb0a-fc3d-c748-ad46-2998403ddb3d"],
 " or ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[CapitalDelta]", 
     RowBox[{"m", ",", "n"}]], "-"], TraditionalForm]],ExpressionUUID->
  "1f8fd779-3112-e442-9c09-e10093be0c50"],
 ") obtained by randomly repartitioning the pooled sample ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Z",
     FontWeight->"Bold"], 
    RowBox[{"m", "+", "n"}]], TraditionalForm]],ExpressionUUID->
  "2b6a5ef7-17a5-3d45-9f9e-b4d47e499ba1"],
 " into two groups of sizes ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a478e3c0-7fc4-2740-bf4b-d89ac30a468a"],
 " and ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d767b61f-7af5-5945-951b-592dc81d3096"],
 ". By Theorem 1 of Dimitrova, Jia, Kaishev (2026), this permutation p-value \
is asymptotically consistent with the unconditional p-value for arbitrary \
underlying distributions F and G."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{
  3.99001023646537*^9, {3.990010277200569*^9, 3.990010278921385*^9}, {
   3.990017351334936*^9, 3.9900173601538963`*^9}, {3.990018682188408*^9, 
   3.9900186841629333`*^9}, 3.9900203892177296`*^9},
 CellID->118561400,ExpressionUUID->"a9a060f0-39b1-8f4d-a8a3-1e6932671452"],

Cell[TextData[{
 "The algorithm implements the recurrence ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["B", "s"], "(", 
     RowBox[{"i", ",", "j"}], ")"}], "=", 
    RowBox[{
     SubscriptBox["1", "s"], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"i", ",", "j"}], ")"}], "[", 
      RowBox[{
       RowBox[{
        SubscriptBox["B", "s"], "(", 
        RowBox[{
         RowBox[{"i", "-", "1"}], ",", "j"}], ")"}], "+", 
       RowBox[{
        SubscriptBox["B", "s"], "(", 
        RowBox[{"i", ",", 
         RowBox[{"j", "-", "1"}]}], ")"}]}], "]"}]}]}], TraditionalForm]],
  ExpressionUUID->"6bacba4e-f841-fd45-92a3-fd4c22ebcc7f"],
 " on the integer grid ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"i", ",", "j"}], ")"}], ":", " ", 
       RowBox[{
       "0", " ", "\[LessEqual]", " ", "i", " ", "\[LessEqual]", " ", "m"}]}], 
      ",", " ", 
      RowBox[{
      "0", " ", "\[LessEqual]", " ", "j", " ", "\[LessEqual]", " ", "n"}]}], 
     "}"}]}], TraditionalForm]],ExpressionUUID->
  "76302546-23aa-8e41-bc87-0c8ed2600a9a"],
 ", where ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]],ExpressionUUID->
  "07922ac7-930f-3549-8215-561711495676"],
 " is the region defined by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"d", "(", 
     RowBox[{"i", ",", "j"}], ")"}], "<"}], TraditionalForm]],ExpressionUUID->
  "70d87cad-a08e-9940-ac92-3b577ec296b2"],
 " ",
 Cell[BoxData[
  StyleBox["q", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c3d13e11-f123-be49-a126-7631d913dcc7"],
 ". It runs in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "mn", ")"}], TraditionalForm]],ExpressionUUID->
  "cb4b69ed-51ba-a147-b2da-c15feab03f7b"],
 " time, processes one anti-diagonal per iteration, and uses vectorised slice \
assignment for the inner update. All arithmetic is exact; no floating-point \
tolerance is required."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.99001023646537*^9, 3.9900102492975483`*^9}, {
  3.99001736645216*^9, 3.990017485101904*^9}, {3.9900203458745785`*^9, 
  3.9900203458745785`*^9}},
 CellID->26128813,ExpressionUUID->"0054524f-16e7-c346-a0ea-b693ec093577"],

Cell[TextData[{
 "This is the Mathematica counterpart of ",
 StyleBox["KS2sample",
  FontVariations->{"Underline"->True}],
 " and ",
 StyleBox["KS2sample_Rcpp",
  FontVariations->{"Underline"->True}],
 " in the R package ",
 ButtonBox["KSgeneral",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://CRAN.R-project.org/package=KSgeneral"], None},
  ButtonNote->"https://CRAN.R-project.org/package=KSgeneral"],
 " (Dimitrova, Jia, Kaishev 2026). Unlike the R version, which uses \
floating-point arithmetic and requires a tolerance parameter, the Mathematica \
implementation uses exact arithmetic throughout and returns an exact rational \
p-value."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{3.9900114179615707`*^9, 3.990011427831915*^9}, {
  3.990017571378153*^9, 3.990017571378153*^9}},
 CellID->410928379,ExpressionUUID->"13832a95-1735-e34e-81a0-8bbb87c74ff7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Examples",
 Cell[BoxData[
  PaneSelectorBox[{True->
   TemplateBox[{"Examples", 
     Cell[
      BoxData[
       FrameBox[
        Cell[
         TextData[{
          "Demonstrate the function\[CloseCurlyQuote]s usage, starting with \
the most basic use case and describing each example in a preceding text cell.\
\n\nWithin a group, individual examples can be delimited by inserting page \
breaks between them (either using ", 
           Cell[
            BoxData[
             StyleBox[
              TemplateBox[{
                StyleBox[
                "\"[Right-click]\"", FontFamily -> "Source Sans Pro", 
                 FontWeight -> "SemiBold", FontColor -> GrayLevel[0.28627], 
                 FontSize -> 14, StripOnInput -> False], 
                StyleBox[
                "\" \[FilledRightTriangle] \"", FontFamily -> 
                 "Source Sans Pro", FontSize -> 13.86, FontColor -> 
                 GrayLevel[0.5], StripOnInput -> False], 
                StyleBox[
                "\"Insert Page Break\"", FontFamily -> "Source Sans Pro", 
                 FontWeight -> "SemiBold", FontColor -> GrayLevel[0.28627], 
                 FontSize -> 14, StripOnInput -> False]}, "RowDefault"], 
              ShowStringCharacters -> False]]], 
           " between cells or through the menu using ", 
           Cell[
            BoxData[
             StyleBox[
              TemplateBox[{
                StyleBox[
                "\"Insert\"", FontFamily -> "Source Sans Pro", FontWeight -> 
                 "SemiBold", FontColor -> GrayLevel[0.28627], FontSize -> 14, 
                 StripOnInput -> False], 
                StyleBox[
                "\" \[FilledRightTriangle] \"", FontFamily -> 
                 "Source Sans Pro", FontSize -> 13.86, FontColor -> 
                 GrayLevel[0.5], StripOnInput -> False], 
                StyleBox[
                "\"Page Break\"", FontFamily -> "Source Sans Pro", FontWeight -> 
                 "SemiBold", FontColor -> GrayLevel[0.28627], FontSize -> 14, 
                 StripOnInput -> False]}, "RowDefault"], ShowStringCharacters -> 
              False]]], 
           ").\n\nExamples should be grouped into Subsection and \
Subsubsection cells similarly to existing documentation pages. Here are some \
typical Subsection names and the types of examples they normally contain:\n  \
", 
           Cell[
            BoxData[
             StyleBox[
              TemplateBox[{
                StyleBox[
                "\"\[FilledSmallSquare] \"", FontColor -> 
                 RGBColor[0.8, 0.043, 0.008], StripOnInput -> False], 
                StyleBox[
                "\"Basic Examples: \"", FontFamily -> "Source Sans Pro", 
                 FontWeight -> "SemiBold", FontSize -> 14, StripOnInput -> 
                 False]}, "RowDefault"], ShowStringCharacters -> False]]], 
           "most basic function usage\n  ", 
           Cell[
            BoxData[
             StyleBox[
              TemplateBox[{
                StyleBox[
                "\"\[FilledSmallSquare] \"", FontColor -> 
                 RGBColor[0.8, 0.043, 0.008], StripOnInput -> False], 
                StyleBox[
