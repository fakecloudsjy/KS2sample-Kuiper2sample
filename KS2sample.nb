               RowBox[{"L2", "=", 
                RowBox[{"L", "+", "NTIES"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"DL", "=", 
                RowBox[{"L2", "*", "SLOPE"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"L2", "==", "Ni"}], ",", 
                 RowBox[{
                  RowBox[{"IRI2", "=", "m"}], ";", 
                  RowBox[{"ILE2", "=", "m"}]}], ",", 
                 RowBox[{
                  RowBox[{"DEVIAT", "=", 
                   RowBox[{"DELTA", "/", 
                    RowBox[{"wvec", "[", 
                    RowBox[{"[", "L2", "]"}], "]"}]}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"IRI2", "=", 
                   RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Ceiling", "[", 
                    RowBox[{"DL", "+", "DEVIAT"}], "]"}], "-", "1"}], ",", 
                    "L2", ",", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
                  RowBox[{"ILE2", "=", 
                   RowBox[{"Max", "[", 
                    RowBox[{
                    RowBox[{"Floor", "[", 
                    RowBox[{"DL", "-", "DEVIAT", "+", "1"}], "]"}], ",", 
                    RowBox[{"L2", "-", "n"}], ",", "0"}], "]"}]}]}]}], "]"}], 
               ";", "\[IndentingNewLine]", 
               RowBox[{"ILEFT", "=", "ILE"}], ";", "\[IndentingNewLine]", 
               RowBox[{"IRIGHT", "=", "IRI2"}], ";", "\[IndentingNewLine]", 
               RowBox[{"JUPP", "=", 
                RowBox[{"L2", "-", "ILE2"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"JLOW", "=", 
                RowBox[{"L", "-", "IRI", "-", "1"}]}]}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"ILE", "=", 
             RowBox[{"Max", "[", 
              RowBox[{"ILEFT", ",", 
               RowBox[{"L", "-", "JUPP"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"IRI", "=", 
             RowBox[{"Min", "[", 
              RowBox[{"IRIGHT", ",", 
               RowBox[{"L", "-", "JLOW"}]}], "]"}]}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"IRI", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"altCode", "==", "3"}], ",", 
            RowBox[{"Min", "[", 
             RowBox[{"m", ",", "1"}], "]"}], ",", "IRI"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"ILE", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"altCode", "==", "2"}], ",", 
            RowBox[{"Max", "[", 
             RowBox[{"0", ",", 
              RowBox[{"L", "-", "n"}]}], "]"}], ",", "ILE"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"recurrence", " ", 
           RowBox[{"B_S", ":", 
            RowBox[{
            "count", " ", "trajectories", " ", "staying", " ", "inside", " ", 
             "region", " ", "S"}]}]}], "*)"}], 
         RowBox[{"ILES", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"0", ",", "ILE"}], "]"}]}], ";", 
         RowBox[{"IRIS", "=", 
          RowBox[{"Min", "[", 
           RowBox[{"L", ",", "IRI"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"P", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"ILES", "+", "1"}], ")"}], ";;", 
             RowBox[{"(", 
              RowBox[{"IRIS", "+", "1"}], ")"}]}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"R", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"ILES", "+", "2"}], ")"}], ";;", 
              RowBox[{"(", 
               RowBox[{"IRIS", "+", "2"}], ")"}]}], "]"}], "]"}], "+", 
           RowBox[{"R", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"ILES", "+", "1"}], ")"}], ";;", 
              RowBox[{"(", 
               RowBox[{"IRIS", "+", "1"}], ")"}]}], "]"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "boundary", " ", "sentinels", " ", "for", " ", "the", " ", "edges", 
           " ", "of", " ", "the", " ", "grid"}], "*)"}], 
         RowBox[{"ILES", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"1", ",", "ILE"}], "]"}]}], ";", 
         RowBox[{"IRIS", "=", 
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{"L", "-", "1"}], ",", "IRI"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"P", "[", 
           RowBox[{"[", "ILES", "]"}], "]"}], "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"ILE", "==", "0"}], ",", "1", ",", "0"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"P", "[", 
           RowBox[{"[", 
            RowBox[{"IRIS", "+", "2"}], "]"}], "]"}], "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"IRI", "==", "L"}], ",", "1", ",", "0"}], "]"}]}]}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"P", "[", 
           RowBox[{"[", 
            RowBox[{"m", "+", "1"}], "]"}], "]"}], "+", 
          RowBox[{"P", "[", 
           RowBox[{"[", "m", "]"}], "]"}]}], ")"}], "/", 
        RowBox[{"Binomial", "[", 
         RowBox[{"Ni", ",", "m"}], "]"}]}]}]}]}], "]"}]}], "\n", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"KS2sample", "[", 
    RowBox[{"data1_List", ",", "data2_List"}], "]"}], ":=", 
   RowBox[{"KS2sample", "[", 
    RowBox[{"data1", ",", "data2", ",", "\"\<TwoSided\>\"", ",", "0"}], 
    "]"}]}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"KS2sample", "[", 
    RowBox[{"data1_List", ",", "data2_List", ",", "alternative_String"}], 
    "]"}], ":=", 
   RowBox[{"KS2sample", "[", 
    RowBox[{"data1", ",", "data2", ",", "alternative", ",", "0"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"KS2sample", "[", 
   RowBox[{
   "data1_List", ",", "data2_List", ",", "alternative_String", ",", 
    "weight_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m", ",", "n", ",", "Ni", ",", "joint", ",", "M", ",", "wvec", ",", 
      "edf1", ",", "edf2", ",", "z", ",", "dstat", ",", "pval", ",", 
      "weightFun"}], "}"}], ",", 
    RowBox[{
     RowBox[{"m", "=", 
      RowBox[{"Length", "[", "data1", "]"}]}], ";", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "data2", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Ni", "=", 
      RowBox[{"m", "+", "n"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"weightFun", "=", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"NumericQ", "[", "weight", "]"}], "&&", 
         RowBox[{"weight", "==", "0"}]}], ",", 
        RowBox[{"Function", "[", 
         RowBox[{"t", ",", "1"}], "]"}], ",", 
        RowBox[{
         RowBox[{"NumericQ", "[", "weight", "]"}], "&&", 
         RowBox[{"0", "<", "weight", "<=", "1"}]}], ",", 
        RowBox[{"Function", "[", 
         RowBox[{"t", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"t", "*", 
             RowBox[{"(", 
              RowBox[{"1", "-", "t"}], ")"}]}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"-", "weight"}], ")"}]}]}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", "weight", "]"}], "===", "Function"}], "||", 
         RowBox[{
          RowBox[{"Head", "[", "weight", "]"}], "===", "Symbol"}]}], ",", 
        "weight", ",", "True", ",", "$Failed"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"weightFun", "===", "$Failed"}], ",", 
       RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"wvec", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "=", 
        RowBox[{"W", 
         RowBox[{"(", 
          RowBox[{"i", "/", 
           RowBox[{"(", 
            RowBox[{"m", "+", "n"}], ")"}]}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"the", " ", "weight", " ", "at", " ", "the", " ", "i"}], "-", 
        RowBox[{"th", " ", "pooled", " ", "order", " ", "statistic"}]}]}], 
      "*)"}], 
     RowBox[{"wvec", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"weightFun", "[", 
         RowBox[{"i", "/", "Ni"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Ni", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"joint", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"Join", "[", 
        RowBox[{"data1", ",", "data2"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"M", "=", 
      RowBox[{"Values", "[", 
       RowBox[{"Counts", "[", "joint", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edf1", "=", 
      RowBox[{"EmpiricalDistribution", "[", "data1", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edf2", "=", 
      RowBox[{"EmpiricalDistribution", "[", "data2", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "weighted", " ", "CDF", " ", "differences", " ", "at", " ", "the", " ",
         "k"}], "-", 
       RowBox[{"1", " ", "interior", " ", "distinct", " ", "pooled"}], "-", 
       RowBox[{"sample", " ", "points"}]}], "*)"}], 
     RowBox[{"joint", "=", 
      RowBox[{"DeleteDuplicates", "[", "joint", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"CDF", "[", 
         RowBox[{"edf1", ",", "joint"}], "]"}], "-", 
        RowBox[{"CDF", "[", 
         RowBox[{"edf2", ",", "joint"}], "]"}]}], ")"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{
       RowBox[{"z", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Length", "[", "joint", "]"}], "-", "1"}], ")"}]}], "]"}],
         "]"}], "*", 
       RowBox[{"wvec", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"Accumulate", "[", "M", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Length", "[", "M", "]"}], "-", "1"}], ")"}]}], "]"}], 
          "]"}], "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<TwoSided\>\"", ",", "\"\<Greater\>\"", 
            ",", "\"\<Less\>\""}], "}"}], ",", "alternative"}], "]"}]}], ",", 
       RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dstat", "=", 
      RowBox[{"Switch", "[", 
       RowBox[{"alternative", ",", "\"\<TwoSided\>\"", ",", 
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", "z", "]"}], "]"}], ",", "\"\<Greater\>\"", ",", 
        RowBox[{"Max", "[", "z", "]"}], ",", "\"\<Less\>\"", ",", 
        RowBox[{"Max", "[", 
         RowBox[{"-", "z"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pval", "=", 
      RowBox[{"KS2sample", "[", 
       RowBox[{
       "m", ",", "n", ",", "alternative", ",", "M", ",", "dstat", ",", 
        "wvec"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"dstat", ",", "pval"}], "}"}]}]}], "]"}]}]}], "Input",
 TaggingRules->{},
