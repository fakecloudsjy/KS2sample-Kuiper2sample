      RowBox[{
       RowBox[{"P", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "=", "1"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SLOPE", "=", 
       RowBox[{"m", "/", "Ni"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"DELTA", "=", 
       RowBox[{"SLOPE", "*", "q", "*", "n"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ILE", "=", 
       RowBox[{"IRI", "=", 
        RowBox[{"ILEFT", "=", 
         RowBox[{"IRIGHT", "=", 
          RowBox[{"ILE2", "=", 
           RowBox[{"IRI2", "=", 
            RowBox[{"L2", "=", 
             RowBox[{"JUPP", "=", 
              RowBox[{"JLOW", "=", 
