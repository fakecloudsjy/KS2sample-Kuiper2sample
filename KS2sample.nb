               RowBox[{"Max", "[", 
                RowBox[{"0", ",", 
                 RowBox[{"L", "-", "n"}]}], "]"}], ",", "ile"}], "]"}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"nties", "=", 
             RowBox[{"multiplicity", "[", 
              RowBox[{"[", "icat", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"icat", "=", 
             RowBox[{"icat", "+", "1"}]}], ";", "\[IndentingNewLine]", 
