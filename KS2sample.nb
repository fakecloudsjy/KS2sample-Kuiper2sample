 DefaultNewCellStyle->"Text",
 CellTags->{"Author Notes", "TemplateCellGroup"},
 CellID->13737072,ExpressionUUID->"599f3fff-d1c9-5b47-b924-73816d37beb6"],

Cell["\<\
The Mathematica implementation uses the original recurrence algorithm of \
Nikiforov (1994), extended by Dimitrova, Jia, Kaishev (2026) to support \
arbitrary weight functions and tied observations. It does not use the \
numerically enhanced Viehmann (2021) variant that is the default in the R \
package KSgeneral (tail = TRUE). Because Mathematica performs exact rational \
arithmetic natively, numerical stability is not a concern and the enhanced \
variant is unnecessary. The returned p-value is an exact rational number.
Computational complexity is O(m\[CenterDot]n). For sample sizes in the \
hundreds, evaluation takes a few seconds. For very large samples (m\
\[CenterDot]n > ~50,000), the asymptotic formula of Theorem 2 of Dimitrova, \
Jia, Kaishev (2026) is more efficient, but is not included here.\
\>", "Text",
 TaggingRules->{},
 CellEventActions->{Inherited, {"KeyDown", "\t"} :> Replace[SelectionMove[
       SelectedNotebook[], After, Cell]; NotebookFind[
       SelectedNotebook[], "TabNext", Next, CellTags, AutoScroll -> True, 
       WrapAround -> True], Blank[NotebookSelection] :> SelectionMove[
       SelectedNotebook[], All, CellContents, AutoScroll -> True]], 
   PassEventsDown -> False, PassEventsUp -> False},
 CellChangeTimes->{{3.990012346673212*^9, 3.9900123885043144`*^9}, {
  3.990015957314741*^9, 3.990015964258772*^9}},
 CellTags->{"DefaultContent", "TabNext"},
 CellID->908162033,ExpressionUUID->"5b5c1e1e-5458-e04e-8fdd-524ee84e1c1a"]
}, Open  ]],

