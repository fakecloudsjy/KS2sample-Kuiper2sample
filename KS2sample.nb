   RowBox[{"KS2sample", "[", 
    RowBox[{"data1", ",", "data2", ",", "alternative", ",", "0"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"KS2sample", "[", 
   RowBox[{
   "data1_List", ",", "data2_List", ",", "alternative_String", ",", 
    "weight_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m", ",", "n", ",", "ni", ",", "joint", ",", "multiplicity", ",", "wvec",
       ",", "edf1", ",", "edf2", ",", "z", ",", "dstat", ",", "pval", ",", 
      "weightFun"}], "}"}], ",", 
    RowBox[{
     RowBox[{"m", "=", 
      RowBox[{"Length", "[", "data1", "]"}]}], ";", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "data2", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ni", "=", 
      RowBox[{"m", "+", "n"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"weightFun", "=", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"NumericQ", "[", "weight", "]"}], "&&", 
         RowBox[{"weight", "==", "0"}]}], ",", 
        RowBox[{"Function", "[", 
         RowBox[{"t", ",", "1"}], "]"}], ",", 
        RowBox[{
         RowBox[{"NumericQ", "[", "weight", "]"}], "&&", 
         RowBox[{"0", "<", "weight", "<=", "1"}]}], ",", 
        RowBox[{"Function", "[", 
         RowBox[{"t", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"t", "*", 
             RowBox[{"(", 
              RowBox[{"1", "-", "t"}], ")"}]}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"-", "weight"}], ")"}]}]}], "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", "weight", "]"}], "===", "Function"}], "||", 
         RowBox[{
          RowBox[{"Head", "[", "weight", "]"}], "===", "Symbol"}]}], ",", 
        "weight", ",", "True", ",", "$Failed"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"weightFun", "===", "$Failed"}], ",", 
       RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"wvec", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "=", 
        RowBox[{"W", 
         RowBox[{"(", 
          RowBox[{"i", "/", 
           RowBox[{"(", 
            RowBox[{"m", "+", "n"}], ")"}]}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"the", " ", "weight", " ", "at", " ", "the", " ", "i"}], "-", 
        RowBox[{"th", " ", "pooled", " ", "order", " ", "statistic"}]}]}], 
      "*)"}], 
     RowBox[{"wvec", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"weightFun", "[", 
         RowBox[{"i", "/", "ni"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"ni", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"joint", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{"Join", "[", 
        RowBox[{"data1", ",", "data2"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"multiplicity", "=", 
      RowBox[{"Values", "[", 
       RowBox[{"Counts", "[", "joint", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edf1", "=", 
      RowBox[{"EmpiricalDistribution", "[", "data1", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"edf2", "=", 
      RowBox[{"EmpiricalDistribution", "[", "data2", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "weighted", " ", "CDF", " ", "differences", " ", "at", " ", "the", " ",
         "k"}], "-", 
       RowBox[{"1", " ", "interior", " ", "distinct", " ", "pooled"}], "-", 
       RowBox[{"sample", " ", "points"}]}], "*)"}], 
     RowBox[{"joint", "=", 
      RowBox[{"DeleteDuplicates", "[", "joint", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"CDF", "[", 
         RowBox[{"edf1", ",", "joint"}], "]"}], "-", 
        RowBox[{"CDF", "[", 
         RowBox[{"edf2", ",", "joint"}], "]"}]}], ")"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{
       RowBox[{"z", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Length", "[", "joint", "]"}], "-", "1"}], ")"}]}], "]"}],
         "]"}], "*", 
       RowBox[{"wvec", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"Accumulate", "[", "multiplicity", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Length", "[", "multiplicity", "]"}], "-", "1"}], 
             ")"}]}], "]"}], "]"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<TwoSided\>\"", ",", "\"\<Greater\>\"", 
            ",", "\"\<Less\>\""}], "}"}], ",", "alternative"}], "]"}]}], ",", 
       RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dstat", "=", 
      RowBox[{"Switch", "[", 
       RowBox[{"alternative", ",", "\"\<TwoSided\>\"", ",", 
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", "z", "]"}], "]"}], ",", "\"\<Greater\>\"", ",", 
        RowBox[{"Max", "[", "z", "]"}], ",", "\"\<Less\>\"", ",", 
        RowBox[{"Max", "[", 
         RowBox[{"-", "z"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pval", "=", 
      RowBox[{"KS2sample", "[", 
       RowBox[{
       "m", ",", "n", ",", "alternative", ",", "multiplicity", ",", "dstat", ",",
         "wvec"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"dstat", ",", "pval"}], "}"}]}]}], "]"}]}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.99002584940337*^9, 3.9900258494043694`*^9}},
 CellLabel->"In[2]:=",
