            RowBox[{"altCode", "==", "3"}], ",", 
            RowBox[{"Min", "[", 
             RowBox[{"m", ",", "1"}], "]"}], ",", "iri"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"ile", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"altCode", "==", "2"}], ",", 
            RowBox[{"Max", "[", 
             RowBox[{"0", ",", 
              RowBox[{"L", "-", "n"}]}], "]"}], ",", "ile"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"recurrence", " ", 
           RowBox[{"B_S", ":", 
            RowBox[{
            "count", " ", "trajectories", " ", "staying", " ", "inside", " ", 
             "region", " ", "S"}]}]}], "*)"}], 
         RowBox[{"iles", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"0", ",", "ile"}], "]"}]}], ";", 
         RowBox[{"iris", "=", 
          RowBox[{"Min", "[", 
           RowBox[{"L", ",", "iri"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"p", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"iles", "+", "1"}], ")"}], ";;", 
             RowBox[{"(", 
              RowBox[{"iris", "+", "1"}], ")"}]}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"r", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"iles", "+", "2"}], ")"}], ";;", 
              RowBox[{"(", 
               RowBox[{"iris", "+", "2"}], ")"}]}], "]"}], "]"}], "+", 
           RowBox[{"r", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"iles", "+", "1"}], ")"}], ";;", 
              RowBox[{"(", 
               RowBox[{"iris", "+", "1"}], ")"}]}], "]"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "boundary", " ", "sentinels", " ", "for", " ", "the", " ", "edges", 
           " ", "of", " ", "the", " ", "grid"}], "*)"}], 
         RowBox[{"iles", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"1", ",", "ile"}], "]"}]}], ";", 
         RowBox[{"iris", "=", 
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{"L", "-", "1"}], ",", "iri"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"p", "[", 
           RowBox[{"[", "iles", "]"}], "]"}], "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"ile", "==", "0"}], ",", "1", ",", "0"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"p", "[", 
           RowBox[{"[", 
            RowBox[{"iris", "+", "2"}], "]"}], "]"}], "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"iri", "==", "L"}], ",", "1", ",", "0"}], "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"L", ",", "1", ",", 
          RowBox[{"ni", "-", "1"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"p", "[", 
           RowBox[{"[", 
            RowBox[{"m", "+", "1"}], "]"}], "]"}], "+", 
          RowBox[{"p", "[", 
           RowBox[{"[", "m", "]"}], "]"}]}], ")"}], "/", 
        RowBox[{"Binomial", "[", 
         RowBox[{"ni", ",", "m"}], "]"}]}]}]}]}], "]"}]}], "\n", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"KS2sample", "[", 
    RowBox[{"data1_List", ",", "data2_List"}], "]"}], ":=", 
