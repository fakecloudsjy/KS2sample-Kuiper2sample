             "\[IndentingNewLine]", 
            RowBox[{"NTIES", "=", 
             RowBox[{"M", "[", 
              RowBox[{"[", "ICAT", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"ICAT", "=", 
             RowBox[{"ICAT", "+", "1"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"NEWRCT", "=", "True"}]}], ",", 
           RowBox[{"(*", 
