  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6d9a45e5-dabd-6445-84b2-f18a6e41bdd3"],
 ": 0 (unweighted, default), \[Nu] \[Element] (0,1] for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{
     RowBox[{
      RowBox[{"W", "(", "t", ")"}], " ", "=", " ", 
      RowBox[{"1", "/", 
       RowBox[{"[", 
        RowBox[{"t", 
         RowBox[{"(", 
          RowBox[{"1", "\[Minus]", "t"}], ")"}]}], "]"}]}]}], ")"}], "\[Nu]"],
    TraditionalForm]],ExpressionUUID->"efe18fd6-c221-c649-9da2-f1305bd5d1d4"],
 ", or a user-supplied pure function."
}], "UsageDescription",
