      "\[IndentingNewLine]", 
      RowBox[{"NTIES", "=", 
       RowBox[{"M", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"R", "=", 
       RowBox[{"Prepend", "[", 
