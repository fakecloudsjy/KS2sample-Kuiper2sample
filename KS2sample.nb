              RowBox[{
              "carry", " ", "bounds", " ", "from", " ", "block", " ", "entry",
                " ", "to", " ", "block", " ", "exit"}]}]}], "*)"}], 
           RowBox[{
            RowBox[{"nties", "=", 
             RowBox[{"nties", "-", "1"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{"newrct", ",", 
              RowBox[{
               RowBox[{"newrct", "=", "False"}], ";", "\[IndentingNewLine]", 
               RowBox[{"l2", "=", 
                RowBox[{"L", "+", "nties"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"dl", "=", 
                RowBox[{"l2", "*", "slope"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"l2", "==", "ni"}], ",", 
                 RowBox[{
                  RowBox[{"iri2", "=", "m"}], ";", 
                  RowBox[{"ile2", "=", "m"}]}], ",", 
                 RowBox[{
                  RowBox[{"deviat", "=", 
                   RowBox[{"delta", "/", 
                    RowBox[{"wvec", "[", 
                    RowBox[{"[", "l2", "]"}], "]"}]}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"iri2", "=", 
                   RowBox[{"Min", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Ceiling", "[", 
                    RowBox[{"dl", "+", "deviat"}], "]"}], "-", "1"}], ",", 
                    "l2", ",", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
                  RowBox[{"ile2", "=", 
                   RowBox[{"Max", "[", 
                    RowBox[{
                    RowBox[{"Floor", "[", 
                    RowBox[{"dl", "-", "deviat", "+", "1"}], "]"}], ",", 
                    RowBox[{"l2", "-", "n"}], ",", "0"}], "]"}]}]}]}], "]"}], 
               ";", "\[IndentingNewLine]", 
               RowBox[{"ileft", "=", "ile"}], ";", "\[IndentingNewLine]", 
               RowBox[{"iright", "=", "iri2"}], ";", "\[IndentingNewLine]", 
               RowBox[{"jupp", "=", 
                RowBox[{"l2", "-", "ile2"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"jlow", "=", 
                RowBox[{"L", "-", "iri", "-", "1"}]}]}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"ile", "=", 
             RowBox[{"Max", "[", 
              RowBox[{"ileft", ",", 
               RowBox[{"L", "-", "jupp"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"iri", "=", 
             RowBox[{"Min", "[", 
              RowBox[{"iright", ",", 
               RowBox[{"L", "-", "jlow"}]}], "]"}]}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"iri", "=", 
          RowBox[{"If", "[", 
