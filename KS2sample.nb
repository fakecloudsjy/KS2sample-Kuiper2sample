Cell["\<\
Low-level call with an explicit Anderson-Darling weight vector. wvec[[i]] = \
W(i/22) = (i/22 * (1 - i/22))^(-1/2) for i = 1,\[Ellipsis],21:\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.990011606008587*^9, 3.990011657544691*^9}, {
   3.99001169003216*^9, 3.990011698287449*^9}, 3.9900117391926346`*^9, {
   3.990015325254692*^9, 3.9900153298049145`*^9}},
 CellTags->"DefaultContent",
 CellID->41623153,ExpressionUUID->"0cecd86b-1695-b14e-88cb-d9e5f88e0813"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"wvec", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"i", "/", "22"}], "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"i", "/", "22"}]}], ")"}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "2"}], ")"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "21"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"KS2sample", "[", 
  RowBox[{"10", ",", "12", ",", "\"\<TwoSided\>\"", ",", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"1", ",", "22"}], "]"}], ",", 
   RowBox[{"1", "/", "2"}], ",", "wvec"}], "]"}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.9900116130029144`*^9, 3.990011666360754*^9}, 
   3.990011713506687*^9, {3.990011748177557*^9, 3.9900118159045906`*^9}, {
   3.9900118750916386`*^9, 3.9900119088885784`*^9}},
 CellTags->"DefaultContent",
 CellLabel->"In[36]:=",
 CellID->349231166,ExpressionUUID->"6a62171a-b385-164c-97d2-4f340cab5d4a"],

Cell[BoxData[
 FractionBox["23675", "24871"]], "Output",
