        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"altCode", "=", 
       RowBox[{"Switch", "[", 
        RowBox[{
        "alternative", ",", "\"\<TwoSided\>\"", ",", "1", 
